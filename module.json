{
  "id": "rebreya-main",
  "title": "Rebreya Main",
  "description": "Модуль экономики сеттинга Rebreya для Foundry VTT.",
  "authors": [
    {
      "name": "ill_lich"
    }
  ],
  "version": "1.4.102",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "socket": true,
  "styles": [
    "styles/main.css",
    "styles/quest-log-enhancements.css"
  ],
  "languages": [
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],
  "documentTypes": {
    "Item": {
      "state": {
        "htmlFields": [
          "description.value",
          "description.chat"
        ]
      },
      "downtime": {
        "htmlFields": [
          "description.value",
          "description.chat"
        ]
      }
    }
  },
  "relationships": {
    "requires": [
      {
        "id": "statuscounter",
        "type": "module",
        "compatibility": {
          "minimum": "3.0.4"
        }
      }
    ]
  },
  "url": "",
  "manifest": "",
  "download": ""
}
