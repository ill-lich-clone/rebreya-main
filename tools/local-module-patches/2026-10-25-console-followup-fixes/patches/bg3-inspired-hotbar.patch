+// Layout references copied by native cross-scene transfers retain the token ID.
+function resolveCurrentTokenItem(uuid, token) {
+    const document = token?.document ?? token;
+    const match = /^Scene\.[^.]+\.Token\.([^.]+)\.Actor\.([^.]+)\.Item\.([^.]+)$/u.exec(uuid ?? '');
+    if (!match || document?.id !== match[1] || document.actor?.id !== match[2]) return undefined;
+    const sourceSceneId = String(uuid).split('.')[1];
+    if (sourceSceneId !== document.parent?.id && globalThis.game?.scenes?.get?.(sourceSceneId)?.tokens?.has?.(match[1])) return undefined;
+    return document.actor.items.get(match[3]) ?? null;
+}
+
+export function isItemUseContextCurrent(item, token) {
+    const document = token?.document ?? token;
+    if (!token || globalThis.ui?.BG3HOTBAR?.manager?.token !== token
+        || globalThis.canvas?.scene?.id !== document?.parent?.id
+        || globalThis.canvas?.tokens?.get?.(token.id) !== token) return false;
+    const currentItem = resolveCurrentTokenItem(item?.uuid, token);
+    return currentItem === undefined || currentItem === item;
+}
