<section class="tab {{ characterDowntimeTab.cssClass }} rm-character-downtime-tab" data-tab="{{ characterDowntimeTab.id }}" data-group="{{ characterDowntimeTab.group }}" data-actor-id="{{characterDowntime.actorId}}">
  <section class="rm-character-downtime-card">
    {{#if characterDowntime.warning}}
      <p class="rm-inline-status rm-inline-status--warning">
        <span>{{ characterDowntime.warning }}</span>
      </p>
    {{/if}}

    <section class="rm-character-downtime-summary">
      <article class="rm-character-downtime-stat rm-character-downtime-stat--focus" data-tooltip="Можно заявить сейчас">
        <span>Свободно {{rmNum characterDowntime.balance.availableWeeks precision=0}} нед.</span>
      </article>
      <article class="rm-character-downtime-stat" data-tooltip="По активным заявкам">
        <span>В резерве {{rmNum characterDowntime.balance.reservedWeeks precision=0}} нед.</span>
      </article>
      <article class="rm-character-downtime-stat" data-tooltip="Из {{rmNum characterDowntime.balance.totalGrantedWeeks precision=0}} выданных">
        <span>Потрачено {{rmNum characterDowntime.balance.spentWeeks precision=0}} нед.</span>
      </article>
    </section>

    <section class="rm-character-downtime-form">
      <div class="rm-field rm-character-downtime-form__action">
        <input type="hidden" value="{{characterDowntime.form.actionId}}" data-action="character-downtime-action">
        <div class="rm-character-downtime-picker">
          <button
            type="button"
            class="rm-button rm-button--small rm-button--secondary rm-character-downtime-library-button"
            data-action="character-downtime-open-library"
            data-tooltip="Выбрать простой из библиотеки Rebreya"
            {{#if characterDowntime.libraryDisabled}}disabled{{/if}}
          >
            <i class="fa-solid fa-book-open"></i>
            <span data-action="character-downtime-action-label">{{characterDowntime.selectedActionLabel}}</span>
          </button>
          {{#if characterDowntime.selectedTemplate}}
            <button
              type="button"
              class="rm-icon-button rm-character-downtime-clear-action"
              data-action="character-downtime-clear-action"
              data-tooltip="Убрать выбранный простой"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>
          {{/if}}
        </div>
      </div>
      <div class="rm-field rm-field--narrow">
        <label>Недели</label>
        <input type="number" min="1" step="1" value="{{characterDowntime.form.weeks}}" data-action="character-downtime-weeks" {{#if characterDowntime.submitDisabled}}disabled{{/if}}>
      </div>

      {{#if characterDowntime.selectedTemplate}}
        <section class="rm-character-downtime-template" data-action="character-downtime-template-preview">
          <div class="rm-status-strip rm-character-downtime-template__meta">
            {{#if characterDowntime.selectedTemplate.hasRank}}
              <span class="rm-badge rm-status-badge rm-status-badge--info" data-tooltip="Ранг простоя">{{characterDowntime.selectedTemplate.rank}}</span>
            {{/if}}
            {{#if characterDowntime.selectedTemplate.hasDuration}}
              <span class="rm-badge rm-status-badge rm-status-badge--info" data-tooltip="Длительность">{{characterDowntime.selectedTemplate.duration}}</span>
            {{/if}}
            {{#if characterDowntime.selectedTemplate.hasRequirements}}
              {{#each characterDowntime.selectedTemplate.requirements}}
                <span class="rm-badge rm-status-badge rm-status-badge--info" data-tooltip="Требование">{{this}}</span>
              {{/each}}
            {{/if}}
          </div>

          {{#if characterDowntime.selectedTemplate.hasDescriptionHtml}}
            <div class="rm-character-downtime-template__description">
              {{{characterDowntime.selectedTemplate.descriptionHtml}}}
            </div>
          {{else if characterDowntime.selectedTemplate.hasSummary}}
            <p class="rm-character-downtime-template__summary">{{characterDowntime.selectedTemplate.summary}}</p>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasDescriptionActions}}
            <div class="rm-character-downtime-template__line rm-character-downtime-description-blocks">
              {{#each characterDowntime.selectedTemplate.descriptionActions}}
                <fieldset class="rm-character-downtime-description-block">
                  <legend>{{label}}</legend>
                  <label>
                    <span>{{descriptionBlock.titleLabel}}</span>
                    <input
                      type="text"
                      value="{{descriptionBlock.title}}"
                      data-action="character-downtime-description-title"
                      data-target-action-id="{{id}}"
                    >
                  </label>
                  <label>
                    <span>{{descriptionBlock.descriptionLabel}}</span>
                    <textarea
                      rows="3"
                      data-action="character-downtime-description-text"
                      data-target-action-id="{{id}}"
                    >{{descriptionBlock.description}}</textarea>
                  </label>
                </fieldset>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasRankActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.rankActions}}
                <label class="rm-character-downtime-resource-choice">
                  <span>{{label}}</span>
                  <select data-action="character-downtime-rank-choice" data-target-action-id="{{id}}">
                    {{#each rankChoices}}
                      <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasCounterActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.counterActions}}
                <span class="rm-chip" data-tooltip="{{label}}">{{label}} {{projectCounter.current}} / {{projectCounter.max}}</span>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasResourceActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.resourceActions}}
                {{#if hasResourceChoices}}
                  <label class="rm-character-downtime-resource-choice">
                    <span>{{label}}</span>
                    <select data-action="character-downtime-resource-choice" data-target-action-id="{{id}}">
                      {{#each resourceChoices}}
                        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} · {{outcomeSummary}}</option>
                      {{/each}}
                    </select>
                  </label>
                {{else if hasResourceQuantity}}
                  <label class="rm-character-downtime-resource-choice">
                    <span>{{label}}</span>
                    <input
                      type="number"
                      min="{{resourceQuantity.min}}"
                      max="{{resourceQuantity.max}}"
                      step="{{resourceQuantity.step}}"
                      value="{{resourceQuantity.displayValue}}"
                      data-action="character-downtime-resource-quantity"
                      data-target-action-id="{{id}}"
                      data-tooltip="{{outcomeSummary}}"
                    >
                  </label>
                {{else}}
                  <span class="rm-chip" data-tooltip="{{label}}">{{outcomeSummary}}</span>
                {{/if}}
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasConfigurableCheckActions}}
            <div class="rm-character-downtime-template__line rm-character-downtime-check-configs">
              {{#each characterDowntime.selectedTemplate.configurableCheckActions}}
                <fieldset class="rm-character-downtime-check-config">
                  <legend>{{label}}</legend>
                  <label>
                    <span>Что бросать</span>
                    <select data-action="character-downtime-check-source" data-target-action-id="{{id}}">
                      {{#each configurableCheck.sourceTypeOptions}}
                        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  {{#if configurableCheck.hasAbilitySelect}}
                    <label>
                      <span>Характеристика</span>
                      <select data-action="character-downtime-check-ability" data-target-action-id="{{id}}">
                        {{#each configurableCheck.abilityOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </label>
                  {{/if}}
                  <label>
                    <span>{{#if configurableCheck.isAbilityOnly}}Характеристика{{else}}Проверка{{/if}}</span>
                    <select data-action="character-downtime-check-target" data-target-action-id="{{id}}">
                      {{#each configurableCheck.targetOptions}}
                        <option value="{{value}}" data-target-label="{{label}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <label>
                    <span>Сложность</span>
                    <input
                      type="number"
                      min="0"
                      step="1"
                      value="{{configurableCheck.dc}}"
                      data-action="character-downtime-check-dc"
                      data-target-action-id="{{id}}"
                      {{#if configurableCheck.isDcLocked}}readonly aria-readonly="true"{{/if}}
                    >
                  </label>
                </fieldset>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasItemChoiceActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.itemChoiceActions}}
                <div
                  class="rm-character-downtime-item-choice rm-character-downtime-item-dropzone {{#if hasSelectedItem}}has-item{{/if}}"
                  data-action="character-downtime-item-choice"
                  data-target-action-id="{{id}}"
                  data-empty-label="{{label}}"
                  data-item-uuid="{{selectedItem.uuid}}"
                  data-item-id="{{selectedItem.id}}"
                  data-item-name="{{selectedItem.name}}"
                  data-item-type="{{selectedItem.type}}"
                  data-item-img="{{selectedItem.img}}"
                  data-item-source-type="{{selectedItem.sourceType}}"
                  data-item-rarity="{{selectedItem.rarity}}"
                  data-item-price-gold="{{selectedItem.priceGold}}"
                  data-item-cost-text="{{selectedItem.costText}}"
                  data-item-snapshot="{{selectedItemJson}}"
                  data-tooltip="{{label}}"
                  role="group"
                >
                  <div class="rm-character-downtime-item-dropzone__main">
                    {{#if selectedItem.img}}
                      <img src="{{selectedItem.img}}" alt="{{selectedItemName}}">
                    {{else}}
                      <i class="fa-solid fa-box-open"></i>
                    {{/if}}
                    <div>
                      <strong data-role="character-downtime-item-choice-label">{{#if hasSelectedItem}}{{selectedItemName}}{{else}}{{label}}{{/if}}</strong>
                      <span data-role="character-downtime-item-choice-price">{{selectedItemPriceLabel}}</span>
                    </div>
                  </div>
                  <button
                    type="button"
                    class="rm-icon-button rm-character-downtime-item-dropzone__clear"
                    data-action="character-downtime-clear-item-choice"
                    data-tooltip="Убрать предмет"
                    {{#unless hasSelectedItem}}hidden{{/unless}}
                  >
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasOptionActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.optionActions}}
                <label class="rm-character-downtime-resource-choice">
                  <span>{{label}}</span>
                  {{#if isMultipleChoice}}
                    <div class="rm-character-downtime-checkbox-grid">
                      {{#each options}}
                        <label>
                          <input type="checkbox" value="{{id}}" data-action="character-downtime-option-checkbox" data-target-action-id="{{../id}}" data-option-id="{{id}}" {{#if selected}}checked{{/if}}>
                          <span>{{label}}</span>
                        </label>
                      {{/each}}
                    </div>
                  {{else}}
                    <select data-action="character-downtime-option-choice" data-target-action-id="{{id}}">
                      {{#each options}}
                        <option value="{{id}}" data-option-value="{{value}}" {{#if selected}}selected{{/if}}>{{displayLabel}}</option>
                      {{/each}}
                    </select>
                  {{/if}}
                </label>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasNumericActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.numericActions}}
                <label class="rm-character-downtime-resource-choice">
                  <span>{{label}}</span>
                  <input
                    type="number"
                    min="{{numericInput.min}}"
                    max="{{numericInput.max}}"
                    step="{{numericInput.step}}"
                    value="{{displayValue}}"
                    data-action="character-downtime-numeric-input"
                    data-target-action-id="{{id}}"
                    data-tooltip="{{label}}"
                  >
                </label>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasFormulaActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.formulaActions}}
                <label class="rm-character-downtime-resource-choice rm-character-downtime-formula-choice">
                  <span>{{label}}</span>
                  <input
                    type="text"
                    value="{{selectedFormula}}"
                    data-action="character-downtime-formula-input"
                    data-target-action-id="{{id}}"
                    data-formula-by-rarity="{{formulaByRarityJson}}"
                    data-trade-step-action-id="{{tradeStepActionId}}"
                    data-item-action-id="{{itemActionId}}"
                    placeholder="{{summary}}"
                  >
                </label>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasCheckActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.checkActions}}
                <span class="rm-chip" data-tooltip="{{label}}">{{summary}}</span>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.hasResultActions}}
            <div class="rm-character-downtime-template__line">
              {{#each characterDowntime.selectedTemplate.resultActions}}
                <span class="rm-chip" data-tooltip="{{label}}">{{summary}}</span>
              {{/each}}
            </div>
          {{/if}}

          {{#if characterDowntime.selectedTemplate.rankTable.length}}
            <div class="rm-character-downtime-rank-table">
              {{#each characterDowntime.selectedTemplate.rankTable}}
                <span>{{rank}}</span>
                <span>{{#if baseCost}}{{baseCost}}{{else}}{{baseTotal}}{{/if}}</span>
                <span>{{stepCost}}</span>
              {{/each}}
            </div>
          {{/if}}
        </section>

        <button
          type="button"
          class="rm-button rm-button--small rm-button--primary rm-character-downtime-form__submit"
          data-action="character-downtime-submit"
          data-tooltip="{{characterDowntime.submitDisabledReason}}"
          {{#if characterDowntime.submitDisabled}}disabled{{/if}}
        >
          <i class="fa-solid fa-paper-plane"></i>
          <span>Отправить</span>
        </button>
      {{/if}}
    </section>

    <section class="rm-character-downtime-history">
      <header>
        <h4>Заявки</h4>
        <span class="rm-muted">{{rmNum characterDowntime.requestCount precision=0}}</span>
      </header>

      {{#if characterDowntime.emptyRequests}}
        <p class="rm-empty">Активных заявок нет.</p>
      {{else}}
        <div class="rm-character-downtime-request-list">
          {{#each characterDowntime.requests}}
            <article class="rm-character-downtime-request {{#if hasProjectCounter}}has-project-counter{{/if}}">
              <div class="rm-character-downtime-request__title">
                <strong>{{title}}</strong>
                {{#if showStatusBadge}}
                  <span class="rm-badge rm-status-badge {{statusClass}}">{{statusLabel}}</span>
                {{/if}}
              </div>
              <p class="rm-muted">{{actionLabel}} • {{rmNum weeks precision=0}} нед.</p>
              {{#if description}}
                <p>{{description}}</p>
              {{/if}}
              {{#if hasResult}}
                <p class="rm-inline-status rm-inline-status--info"><span>{{result}}</span></p>
              {{/if}}
              {{#if hasChecks}}
                <div class="rm-status-strip rm-character-downtime-checks">
                  {{#each checks}}
                    <div class="rm-character-downtime-check">
                      <span class="rm-badge rm-status-badge rm-status-badge--info" data-tooltip="Целевое действие простоя">{{summary}}</span>
                      {{#if hasOutcomeSummary}}
                        <span class="rm-badge rm-status-badge rm-status-badge--info">{{outcomeSummary}}</span>
                      {{/if}}
                      {{#if hasResult}}
                        {{#unless hasRollTargets}}
                          <span class="rm-badge rm-status-badge rm-status-badge--good">{{resultLabel}}</span>
                        {{/unless}}
                      {{/if}}
                      {{#if hasRollTargets}}
                        <div class="rm-character-downtime-check__actions">
                          {{#each rollTargets}}
                            <button
                              type="button"
                              class="rm-button rm-button--small rm-button--secondary rm-character-downtime-roll"
                              data-action="character-downtime-roll"
                              data-request-id="{{../../id}}"
                              data-check-id="{{../id}}"
                              data-group-id="{{../../groupId}}"
                              data-actor-id="{{../../actorId}}"
                              data-source-type="{{sourceType}}"
                              data-ability="{{ability}}"
                              data-target="{{target}}"
                              data-target-label="{{label}}"
                              data-outcome-mode="{{outcomeMode}}"
                              data-choice-index="{{choiceIndex}}"
                              data-has-choices="{{#if hasChoices}}true{{/if}}"
                              data-dc="{{dc}}"
                              data-dc-formula="{{dcFormula}}"
                              data-tooltip="{{rollTitle}}"
                              {{#if isResolvedChoice}}data-resolved-choice="true"{{/if}}
                              {{#if isDisabledChoice}}data-disabled-choice="true"{{/if}}
                              {{#unless canRoll}}disabled{{/unless}}
                            >
                              {{#unless isResolvedChoice}}
                                <i class="fa-solid fa-dice-d20"></i>
                              {{/unless}}
                              <span>{{buttonLabel}}</span>
                            </button>
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              {{/if}}
              {{#if hasProjectCounter}}
                <aside class="rm-character-downtime-project-counter">
                  {{#if projectCounter.hasImagePath}}
                    <img src="{{projectCounter.imagePath}}" alt="{{projectCounter.value}} / {{projectCounter.max}}">
                  {{/if}}
                  {{#if projectCounter.canContinue}}
                    <button
                      type="button"
                      class="rm-button rm-button--small rm-button--secondary rm-character-downtime-continue-button"
                      data-action="character-downtime-continue"
                      data-payload="{{projectCounter.continuePayloadJson}}"
                    >
                      Продолжить работу
                    </button>
                  {{/if}}
                </aside>
              {{/if}}
            </article>
          {{/each}}
        </div>

        <nav class="rm-character-downtime-pagination">
          <button type="button" class="rm-icon-button" data-action="character-downtime-page" data-page-type="request" data-direction="previous" data-tooltip="Предыдущая страница" {{#unless characterDowntime.requestPage.hasPrevious}}disabled{{/unless}}>
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <span class="rm-muted">{{rmNum characterDowntime.requestPage.current precision=0}} / {{rmNum characterDowntime.requestPage.total precision=0}}</span>
          <button type="button" class="rm-icon-button" data-action="character-downtime-page" data-page-type="request" data-direction="next" data-tooltip="Следующая страница" {{#unless characterDowntime.requestPage.hasNext}}disabled{{/unless}}>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </nav>
      {{/if}}
    </section>

    {{#if characterDowntime.hasCurrentProjects}}
      <section class="rm-character-downtime-history rm-character-downtime-history--projects">
        <header>
          <h4>Текущие проекты</h4>
          <span class="rm-muted">{{rmNum characterDowntime.currentProjectCount precision=0}}</span>
        </header>

        <div class="rm-character-downtime-request-list">
          {{#each characterDowntime.currentProjects}}
            <article class="rm-character-downtime-request {{#if hasProjectCounter}}has-project-counter{{/if}}">
              <div class="rm-character-downtime-request__title">
                <strong>{{title}}</strong>
                {{#if showStatusBadge}}
                  <span class="rm-badge rm-status-badge {{statusClass}}">{{statusLabel}}</span>
                {{/if}}
              </div>
              <p class="rm-muted">{{actionLabel}} • {{rmNum weeks precision=0}} нед.</p>
              {{#if description}}
                <p>{{description}}</p>
              {{/if}}
              {{#if hasResult}}
                <p class="rm-inline-status rm-inline-status--info"><span>{{result}}</span></p>
              {{/if}}
              {{#if hasChecks}}
                <div class="rm-status-strip rm-character-downtime-checks">
                  {{#each checks}}
                    <div class="rm-character-downtime-check">
                      <span class="rm-badge rm-status-badge rm-status-badge--info" data-tooltip="Целевое действие простоя">{{summary}}</span>
                      {{#if hasOutcomeSummary}}
                        <span class="rm-badge rm-status-badge rm-status-badge--info">{{outcomeSummary}}</span>
                      {{/if}}
                      {{#if hasResult}}
                        <span class="rm-badge rm-status-badge rm-status-badge--good">{{resultLabel}}</span>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              {{/if}}
              {{#if hasProjectCounter}}
                <aside class="rm-character-downtime-project-counter">
                  {{#if projectCounter.hasImagePath}}
                    <img src="{{projectCounter.imagePath}}" alt="{{projectCounter.value}} / {{projectCounter.max}}">
                  {{/if}}
                  {{#if projectCounter.canContinue}}
                    <button
                      type="button"
                      class="rm-button rm-button--small rm-button--secondary rm-character-downtime-continue-button"
                      data-action="character-downtime-continue"
                      data-payload="{{projectCounter.continuePayloadJson}}"
                    >
                      Продолжить работу
                    </button>
                  {{/if}}
                </aside>
              {{/if}}
            </article>
          {{/each}}
        </div>

        <nav class="rm-character-downtime-pagination">
          <button type="button" class="rm-icon-button" data-action="character-downtime-page" data-page-type="currentProject" data-direction="previous" data-tooltip="Предыдущая страница" {{#unless characterDowntime.currentProjectPage.hasPrevious}}disabled{{/unless}}>
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <span class="rm-muted">{{rmNum characterDowntime.currentProjectPage.current precision=0}} / {{rmNum characterDowntime.currentProjectPage.total precision=0}}</span>
          <button type="button" class="rm-icon-button" data-action="character-downtime-page" data-page-type="currentProject" data-direction="next" data-tooltip="Следующая страница" {{#unless characterDowntime.currentProjectPage.hasNext}}disabled{{/unless}}>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </nav>
      </section>
    {{/if}}

    {{#if characterDowntime.hasArchiveRequests}}
      <section class="rm-character-downtime-history rm-character-downtime-history--archive">
        <header>
          <h4>Архив</h4>
          <span class="rm-muted">{{rmNum characterDowntime.archiveCount precision=0}}</span>
        </header>

        <div class="rm-character-downtime-request-list">
          {{#each characterDowntime.archiveRequests}}
            <article class="rm-character-downtime-request is-archived">
              <div class="rm-character-downtime-request__title">
                <strong>{{title}}</strong>
                <span class="rm-badge rm-status-badge {{statusClass}}">{{statusLabel}}</span>
              </div>
              <p class="rm-muted">{{actionLabel}} • {{rmNum weeks precision=0}} нед.</p>
              {{#if hasResult}}
                <p class="rm-inline-status rm-inline-status--info"><span>{{result}}</span></p>
              {{/if}}
              {{#if hasChecks}}
                <div class="rm-status-strip rm-character-downtime-checks">
                  {{#each checks}}
                    <div class="rm-character-downtime-check">
                      <span class="rm-badge rm-status-badge rm-status-badge--info">{{summary}}</span>
                      {{#if hasResult}}
                        <span class="rm-badge rm-status-badge rm-status-badge--good">{{resultLabel}}</span>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              {{/if}}
            </article>
          {{/each}}
        </div>

        <nav class="rm-character-downtime-pagination">
          <button type="button" class="rm-icon-button" data-action="character-downtime-page" data-page-type="archive" data-direction="previous" data-tooltip="Предыдущая страница" {{#unless characterDowntime.archivePage.hasPrevious}}disabled{{/unless}}>
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <span class="rm-muted">{{rmNum characterDowntime.archivePage.current precision=0}} / {{rmNum characterDowntime.archivePage.total precision=0}}</span>
          <button type="button" class="rm-icon-button" data-action="character-downtime-page" data-page-type="archive" data-direction="next" data-tooltip="Следующая страница" {{#unless characterDowntime.archivePage.hasNext}}disabled{{/unless}}>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </nav>
      </section>
    {{/if}}
  </section>
</section>
