<section class="tab {{ characterDowntimeTab.cssClass }} rm-character-downtime-tab" data-tab="{{ characterDowntimeTab.id }}" data-group="{{ characterDowntimeTab.group }}">
  <section class="rm-character-downtime-card">
    {{#if characterDowntime.warning}}
      <p class="rm-inline-status rm-inline-status--warning">
        <span>{{ characterDowntime.warning }}</span>
      </p>
    {{/if}}

    <section class="rm-character-downtime-summary">
      <article class="rm-character-downtime-stat rm-character-downtime-stat--focus">
        <span>Свободно</span>
        <strong>{{rmNum characterDowntime.balance.availableWeeks precision=0}} нед.</strong>
        <small>можно заявить сейчас</small>
      </article>
      <article class="rm-character-downtime-stat">
        <span>В резерве</span>
        <strong>{{rmNum characterDowntime.balance.reservedWeeks precision=0}} нед.</strong>
        <small>по активным заявкам</small>
      </article>
      <article class="rm-character-downtime-stat">
        <span>Потрачено</span>
        <strong>{{rmNum characterDowntime.balance.spentWeeks precision=0}} нед.</strong>
        <small>из {{rmNum characterDowntime.balance.totalGrantedWeeks precision=0}} выданных</small>
      </article>
    </section>

    <section class="rm-character-downtime-form">
      <div class="rm-field rm-character-downtime-form__action">
        <label>Действие</label>
        <input type="hidden" value="{{characterDowntime.form.actionId}}" data-action="character-downtime-action">
        <button
          type="button"
          class="rm-button rm-button--small rm-button--secondary rm-character-downtime-library-button"
          data-action="character-downtime-open-library"
          title="Выбрать простой из библиотеки Rebreya"
          {{#if characterDowntime.libraryDisabled}}disabled{{/if}}
        >
          <i class="fa-solid fa-book-open"></i>
          <span data-action="character-downtime-action-label">{{characterDowntime.selectedActionLabel}}</span>
        </button>
      </div>
      <div class="rm-field rm-field--narrow">
        <label>Недели</label>
        <input type="number" min="1" step="1" value="{{characterDowntime.form.weeks}}" data-action="character-downtime-weeks" {{#if characterDowntime.submitDisabled}}disabled{{/if}}>
      </div>
      <div class="rm-field rm-character-downtime-form__title">
        <label>Название</label>
        <input type="text" value="{{characterDowntime.form.title}}" placeholder="Коротко о цели" data-action="character-downtime-title" {{#if characterDowntime.submitDisabled}}disabled{{/if}}>
      </div>
      <div class="rm-field rm-character-downtime-form__description">
        <label>Описание</label>
        <textarea rows="2" placeholder="Что персонаж хочет сделать" data-action="character-downtime-description" {{#if characterDowntime.submitDisabled}}disabled{{/if}}>{{characterDowntime.form.description}}</textarea>
      </div>
      <button
        type="button"
        class="rm-button rm-button--small rm-button--primary rm-character-downtime-form__submit"
        data-action="character-downtime-submit"
        title="{{characterDowntime.submitDisabledReason}}"
        {{#if characterDowntime.submitDisabled}}disabled{{/if}}
      >
        <i class="fa-solid fa-paper-plane"></i>
        <span>Отправить</span>
      </button>
    </section>

    {{#if characterDowntime.submitDisabledReason}}
      <p class="rm-character-downtime-note">{{ characterDowntime.submitDisabledReason }}</p>
    {{/if}}

    <section class="rm-character-downtime-history">
      <header>
        <h4>Заявки</h4>
        <span class="rm-muted">{{rmNum characterDowntime.requests.length precision=0}}</span>
      </header>

      {{#if characterDowntime.emptyRequests}}
        <p class="rm-empty">Заявок на простой пока нет.</p>
      {{else}}
        <div class="rm-character-downtime-request-list">
          {{#each characterDowntime.requests}}
            <article class="rm-character-downtime-request">
              <div class="rm-character-downtime-request__title">
                <strong>{{title}}</strong>
                <span class="rm-badge rm-status-badge {{statusClass}}">{{statusLabel}}</span>
              </div>
              <p class="rm-muted">{{actionLabel}} • {{rmNum weeks precision=0}} нед.</p>
              {{#if description}}
                <p>{{description}}</p>
              {{/if}}
              {{#if hasResult}}
                <p class="rm-inline-status rm-inline-status--info"><span>{{result}}</span></p>
              {{/if}}
              {{#if hasChecks}}
                <div class="rm-status-strip rm-character-downtime-checks">
                  {{#each checks}}
                    <div class="rm-character-downtime-check">
                      <span class="rm-badge rm-status-badge rm-status-badge--info" title="Целевое действие простоя">{{summary}}</span>
                      {{#if hasResult}}
                        <span class="rm-badge rm-status-badge rm-status-badge--good">{{resultLabel}}</span>
                      {{/if}}
                      {{#if hasRollTargets}}
                        <div class="rm-character-downtime-check__actions">
                          {{#each rollTargets}}
                            <button
                              type="button"
                              class="rm-button rm-button--small rm-button--secondary rm-character-downtime-roll"
                              data-action="character-downtime-roll"
                              data-request-id="{{../../id}}"
                              data-check-id="{{../id}}"
                              data-group-id="{{../../groupId}}"
                              data-actor-id="{{../../actorId}}"
                              data-source-type="{{sourceType}}"
                              data-ability="{{ability}}"
                              data-target="{{target}}"
                              data-target-label="{{label}}"
                              data-outcome-mode="{{outcomeMode}}"
                              data-choice-index="{{choiceIndex}}"
                              data-dc="{{dc}}"
                              title="{{rollTitle}}"
                              {{#unless canRoll}}disabled{{/unless}}
                            >
                              <i class="fa-solid fa-dice-d20"></i>
                              <span>{{buttonLabel}}</span>
                            </button>
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              {{/if}}
            </article>
          {{/each}}
        </div>
      {{/if}}
    </section>
  </section>
</section>
