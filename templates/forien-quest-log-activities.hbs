<div class="tab rebreya-rumors rm-fql-log-panel" data-group="primary" data-tab="rebreya-rumors" data-rm-fql-log-panel="rumors">
  <header>
    <h1 style="flex: 1;">Слухи</h1>
    {{#if canEdit}}
      <button type="button" data-rm-fql-log-action="add-rumor-topic"><i class="fas fa-plus"></i> Слух</button>
    {{/if}}
  </header>

  <div class="table">
    {{#if hasGroupContext}}
      <ul>
        {{#each activities.rumors}}
          <li class="drag-quest rm-fql-activity-row" data-rumor-id="{{id}}" draggable="false">
            <i class="open-quest fas fa-comments pad-l-4" data-rm-fql-log-action="open-rumor-topic" data-rumor-id="{{id}}"></i>
            <div class="open-quest title" data-rm-fql-log-action="open-rumor-topic" data-rumor-id="{{id}}">
              <h2>{{title}}</h2>
              {{#if tableUuid}}<p>{{tableUuid}}</p>{{/if}}
            </div>
            <div class="open-quest tasks" data-rm-fql-log-action="open-rumor-topic" data-rumor-id="{{id}}" title="Записи слухов">{{entries.length}}</div>
            <div class="actions quest-status rm-fql-log-actions">
              {{#if ../canEdit}}
                <i class="fas fa-dice-d20 {{#unless tableUuid}}is-disabled{{/unless}}" data-rm-fql-log-action="roll-rumor-table" data-rumor-id="{{id}}" data-table-uuid="{{tableUuid}}" title="Бросить из таблицы"></i>
              {{/if}}
              <i class="fas fa-folder-open" data-rm-fql-log-action="open-rumor-topic" data-rumor-id="{{id}}" title="Открыть"></i>
              {{#if ../canEdit}}
                <i class="delete fas fa-trash" data-rm-fql-log-action="remove-rumor-topic" data-rumor-id="{{id}}" title="Удалить"></i>
              {{/if}}
            </div>
          </li>
        {{else}}
          <li class="drag-quest rm-fql-activity-row rm-fql-log-empty">
            <div class="title"><h2>Слухов нет.</h2></div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <ul>
        <li class="drag-quest rm-fql-activity-row rm-fql-log-empty">
          <div class="title"><h2>Активная группа Rebreya не найдена.</h2></div>
        </li>
      </ul>
    {{/if}}
  </div>
</div>

<div class="tab rebreya-events rm-fql-log-panel" data-group="primary" data-tab="rebreya-events" data-rm-fql-log-panel="events">
  <header>
    <h1 style="flex: 1;">События</h1>
    {{#if canEdit}}
      <button type="button" data-rm-fql-log-action="add-event"><i class="fas fa-plus"></i> Событие</button>
    {{/if}}
  </header>

  <div class="table">
    {{#if hasGroupContext}}
      <ul>
        {{#each activities.events}}
          <li class="drag-quest rm-fql-activity-row" data-event-id="{{id}}" draggable="false">
            <i class="open-quest fas fa-calendar-day pad-l-4" data-rm-fql-log-action="open-event" data-event-id="{{id}}"></i>
            <div class="open-quest title" data-rm-fql-log-action="open-event" data-event-id="{{id}}">
              <h2>{{title}}</h2>
              {{#if text}}<p>{{text}}</p>{{/if}}
            </div>
            <div class="actions quest-status rm-fql-log-actions">
              <i class="fas fa-folder-open" data-rm-fql-log-action="open-event" data-event-id="{{id}}" title="Открыть"></i>
              {{#if ../canEdit}}
                <i class="delete fas fa-trash" data-rm-fql-log-action="remove-event" data-event-id="{{id}}" title="Удалить"></i>
              {{/if}}
            </div>
          </li>
        {{else}}
          <li class="drag-quest rm-fql-activity-row rm-fql-log-empty">
            <div class="title"><h2>Событий нет.</h2></div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <ul>
        <li class="drag-quest rm-fql-activity-row rm-fql-log-empty">
          <div class="title"><h2>Активная группа Rebreya не найдена.</h2></div>
        </li>
      </ul>
    {{/if}}
  </div>
</div>
