<div class="tab rm-fql-log-panel" data-group="primary" data-tab="rebreya-rumors" data-rm-fql-log-panel="rumors" hidden>
  <header class="rm-fql-log-panel__header">
    <h1>Слухи</h1>
    {{#if hasGroupContext}}
      <button type="button" data-rm-fql-log-action="add-rumor-topic"><i class="fas fa-plus"></i> Слух</button>
    {{/if}}
  </header>

  {{#if hasGroupContext}}
    <div class="rm-fql-log-list">
      {{#each activities.rumors}}
        <article class="rm-fql-log-card" data-rumor-id="{{id}}">
          <header>
            <h2>{{title}}</h2>
            <div class="rm-fql-log-card__actions">
              <button type="button" data-rm-fql-log-action="roll-rumor-table" data-rumor-id="{{id}}" data-table-uuid="{{tableUuid}}" {{#unless tableUuid}}disabled{{/unless}}><i class="fas fa-dice-d20"></i></button>
              <button type="button" data-rm-fql-log-action="add-rumor-entry" data-rumor-id="{{id}}"><i class="fas fa-plus"></i></button>
              <button type="button" data-rm-fql-log-action="edit-rumor-topic" data-rumor-id="{{id}}"><i class="fas fa-pen"></i></button>
              <button type="button" data-rm-fql-log-action="remove-rumor-topic" data-rumor-id="{{id}}"><i class="fas fa-trash"></i></button>
            </div>
          </header>
          {{#if tableUuid}}<p class="rm-fql-log-muted">{{tableUuid}}</p>{{/if}}
          <ul class="rm-fql-rumor-entries">
            {{#each entries}}
              <li data-rumor-entry-id="{{id}}">
                <span>{{text}}</span>
                <span class="rm-fql-log-card__actions">
                  <button type="button" data-rm-fql-log-action="edit-rumor-entry" data-rumor-id="{{../id}}" data-rumor-entry-id="{{id}}"><i class="fas fa-pen"></i></button>
                  <button type="button" data-rm-fql-log-action="remove-rumor-entry" data-rumor-id="{{../id}}" data-rumor-entry-id="{{id}}"><i class="fas fa-trash"></i></button>
                </span>
              </li>
            {{/each}}
          </ul>
        </article>
      {{else}}
        <p class="rm-fql-log-empty">Слухов нет.</p>
      {{/each}}
    </div>
  {{else}}
    <p class="rm-fql-log-empty">Активная группа Rebreya не найдена.</p>
  {{/if}}
</div>

<div class="tab rm-fql-log-panel" data-group="primary" data-tab="rebreya-events" data-rm-fql-log-panel="events" hidden>
  <header class="rm-fql-log-panel__header">
    <h1>События</h1>
    {{#if hasGroupContext}}
      <button type="button" data-rm-fql-log-action="add-event"><i class="fas fa-plus"></i> Событие</button>
    {{/if}}
  </header>

  {{#if hasGroupContext}}
    <div class="rm-fql-log-list">
      {{#each activities.events}}
        <article class="rm-fql-log-card" data-event-id="{{id}}">
          <header>
            <h2>{{title}}</h2>
            <div class="rm-fql-log-card__actions">
              <button type="button" data-rm-fql-log-action="edit-event" data-event-id="{{id}}"><i class="fas fa-pen"></i></button>
              <button type="button" data-rm-fql-log-action="remove-event" data-event-id="{{id}}"><i class="fas fa-trash"></i></button>
            </div>
          </header>
          {{#if text}}<p>{{text}}</p>{{/if}}
        </article>
      {{else}}
        <p class="rm-fql-log-empty">Событий нет.</p>
      {{/each}}
    </div>
  {{else}}
    <p class="rm-fql-log-empty">Активная группа Rebreya не найдена.</p>
  {{/if}}
</div>
