<section class="tab {{ heroDollTab.cssClass }} rm-hero-doll-tab" data-tab="{{ heroDollTab.id }}" data-group="{{ heroDollTab.group }}">
  <div class="rm-hero-doll-tab__layout">
    <section class="rm-hero-doll-board card">
      <header class="rm-hero-doll-board__header">
        <div>
          <h2>Кукла героя</h2>
          <p>Перетаскивайте предметы из списка справа или из партийного склада прямо в нужный слот.</p>
        </div>
        <button type="button" class="rm-hero-doll-tab__button unbutton always-interactive" data-action="open-party-inventory">
          <i class="fa-solid fa-box-open" inert></i>
          <span>Склад группы</span>
        </button>
      </header>

      <div class="rm-hero-doll-presets">
        <select data-hero-doll-preset-select aria-label="Комплект куклы" {{#unless heroDoll.canEditPresets}}disabled{{/unless}}>
          <option value="">Выберите комплект</option>
          {{#each heroDoll.presets}}
            <option value="{{ id }}" {{#if selected}}selected{{/if}}>{{ name }}</option>
          {{/each}}
        </select>
        <button type="button" class="rm-hero-doll-tab__button unbutton always-interactive" data-preset-command="apply" {{#unless heroDoll.canEditPresets}}disabled{{/unless}}>Применить</button>
        <button type="button" class="rm-hero-doll-tab__button unbutton always-interactive" data-preset-command="save" {{#unless heroDoll.canEditPresets}}disabled{{/unless}}>Сохранить</button>
        <button type="button" class="rm-icon-button always-interactive" data-preset-command="manage" aria-label="Управление комплектами" title="Управление комплектами" {{#unless heroDoll.canEditPresets}}disabled{{/unless}}><i class="fa-solid fa-ellipsis"></i></button>
        {{#if heroDoll.presetModified}}<span class="rm-hero-doll-presets__modified">Изменён</span>{{/if}}
      </div>

      <div class="rm-hero-doll-grid">
        {{#each heroDoll.slots}}
          <div class="rm-hero-doll-slot rm-hero-doll-slot--{{ area }}">
            <button
              type="button"
              class="rm-hero-doll-slot__surface unbutton always-interactive {{#if occupied}}is-occupied{{/if}} {{#if ghost}}is-ghost{{/if}}"
              data-hero-doll-slot="true"
              data-action="{{#if occupied}}open-slot-item{{else}}slot-drop{{/if}}"
              data-slot-id="{{ id }}"
              {{#if occupied}}data-item-id="{{ itemId }}"{{/if}}
              aria-label="{{ title }}"
              data-rm-tooltip="{{ title }}"
              data-tooltip-meta="{{ itemMeta }}"
            >
              {{#if occupied}}
                <img class="rm-hero-doll-slot__image" src="{{ itemImg }}" alt="">
              {{else}}
                {{#if ghost}}
                  <img class="rm-hero-doll-slot__image rm-hero-doll-slot__image--ghost" data-hero-doll-ghost-image="true" src="{{ itemImg }}" alt="{{ itemName }}">
                {{else}}
                  <span class="rm-hero-doll-slot__empty">{{ label }}</span>
                {{/if}}
              {{/if}}
            </button>

            {{#if legacyStack}}
              <button type="button" class="rm-hero-doll-slot__normalize rm-icon-button always-interactive" data-action="normalize-slot-stack" data-slot-id="{{ id }}" title="Выделить одну экипированную единицу">
                <i class="fa-solid fa-layer-group"></i>
              </button>
            {{/if}}
            {{#if ghost}}
              <button type="button" class="rm-hero-doll-slot__clear rm-icon-button always-interactive" data-action="clear-slot" data-slot-id="{{ id }}" title="Убрать силуэт" aria-label="Убрать силуэт" {{#unless ../heroDoll.canEditPresets}}disabled{{/unless}}><i class="fa-solid fa-xmark"></i></button>
            {{/if}}
            {{#if occupied}}
              <button
                type="button"
                class="rm-hero-doll-slot__clear rm-icon-button rm-icon-button--danger always-interactive"
                data-action="clear-slot"
                data-slot-id="{{ id }}"
                title="Освободить слот"
              >
                <i class="fa-solid fa-xmark"></i>
              </button>
            {{/if}}
          </div>
        {{/each}}
      </div>
    </section>

    <section class="rm-hero-doll-stock card">
      <header class="rm-hero-doll-stock__header">
        <div>
          <h3>Инвентарь персонажа</h3>
          <p>Щёлкните по иконке, чтобы открыть предмет. Перетаскивайте строку в слот куклы.</p>
        </div>
        <span class="rm-hero-doll-badge">{{ heroDoll.reservedCount }}/{{ heroDoll.slotCount }}</span>
      </header>

      {{#if heroDoll.hasInventoryItems}}
        <ol class="rm-hero-doll-stock__list unlist">
          {{#each heroDoll.inventoryItems}}
            <li
              class="rm-hero-doll-stock__item {{#if reserved}}is-reserved{{/if}}"
              draggable="true"
              data-hero-doll-item-drag="true"
              data-item-id="{{ id }}"
              data-item-uuid="{{ itemUuid }}"
              data-allowed-slots="{{ allowedSlotsCsv }}"
              title="{{ title }}"
            >
              <div class="rm-hero-doll-stock__main">
                <img class="rm-hero-doll-stock__image gold-icon" src="{{ img }}" alt="{{ name }}">
                <div class="rm-hero-doll-stock__copy">
                  <strong>{{ name }}</strong>
                  {{#if meta}}
                    <p>{{ meta }}</p>
                  {{/if}}
                </div>
              </div>

              <div class="rm-hero-doll-stock__actions">
                {{#if reserved}}
                  <span class="rm-hero-doll-badge">{{ reservedSlotLabel }}</span>
                {{/if}}
                <button
                  type="button"
                  class="rm-icon-button always-interactive"
                  data-action="open-inventory-item"
                  data-item-id="{{ id }}"
                  title="Открыть предмет"
                >
                  <i class="fa-solid fa-up-right-from-square"></i>
                </button>
              </div>
            </li>
          {{/each}}
        </ol>
      {{else}}
        <p class="rm-hero-doll-stock__empty">В инвентаре персонажа нет предметов, которые можно использовать в кукле героя.</p>
      {{/if}}
    </section>
  </div>
</section>
