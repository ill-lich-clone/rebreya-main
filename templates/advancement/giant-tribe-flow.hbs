<form id="{{appId}}" data-level="{{level}}" data-id="{{advancement.id}}" data-type="{{type}}">
    <h3>{{{title}}}</h3>
    {{#if hint}}<p>{{hint}}</p>{{/if}}
    <select name="size" required>
        <option value="" disabled {{#unless selectedTribe}}selected{{/unless}}>Выберите племя</option>
        {{selectOptions choices selected=selectedTribe}}
    </select>
</form>
