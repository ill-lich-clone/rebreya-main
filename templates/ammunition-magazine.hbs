<div class="rm-ammo-body" aria-busy="{{busy}}">
  <header class="rm-ammo-header">
    <div><h2>{{weaponName}}</h2><p>{{presentation.subtitle}} · {{groupSize}} на атаку</p></div>
    <div class="rm-ammo-count"><strong>{{current}} <span>/ {{capacity}}</span></strong><small>{{presentation.unit}}</small></div>
  </header>
  {{#if error}}<p class="rm-ammo-error" role="alert">{{error}}</p>{{/if}}
  <fieldset {{#if busy}}disabled{{/if}}>
    <div class="rm-ammo-workbench">
      <section class="rm-ammo-magazine" aria-label="Магазин и порядок выстрелов">
        <div class="rm-ammo-section-title"><h3>{{presentation.title}}</h3><span>{{presentation.order}}</span></div>
        <div class="rm-ammo-stage">
          <nav class="rm-ammo-groups" aria-label="Ячейки будущих атак">
            {{#each cells}}
            <div class="rm-ammo-group-label rm-ammo-tone-{{tone}} {{#if selected}}is-selected{{/if}}">
              <button type="button" class="rm-ammo-group-select" data-ammo-action="select" data-index="{{index}}" aria-pressed="{{selected}}" {{#if locked}}disabled{{/if}}>
                <span class="rm-ammo-group-number">{{number}}</span>
                <span><small>{{#if first}}Следующая атака{{else}}Атака {{number}}{{/if}}</small><strong title="{{name}}">{{shortName}}</strong><em>{{count}} / {{size}}</em></span>
              </button>
              <div class="rm-ammo-reorder">
                <button type="button" data-ammo-action="up" data-index="{{index}}" aria-label="Переместить ячейку {{number}} выше"><i class="fa-solid fa-chevron-up"></i></button>
                <button type="button" data-ammo-action="down" data-index="{{index}}" aria-label="Переместить ячейку {{number}} ниже"><i class="fa-solid fa-chevron-down"></i></button>
              </div>
            </div>
            {{/each}}
          </nav>
          <svg class="rm-ammo-physical rm-ammo-visual-{{presentation.kind}}" viewBox="{{presentation.viewBox}}" role="group" aria-label="{{presentation.title}}, {{current}} из {{capacity}}">
            {{#if presentation.isCurved}}
            <defs>
              <clipPath id="{{clipId}}-body"><path d="M82 75 L155 41 L170 75 C186 154 169 261 111 345 L42 307 C86 234 95 156 82 75 Z"/></clipPath>
              <clipPath id="{{clipId}}-window"><path d="{{presentation.windowPath}}"/></clipPath>
            </defs>
            <image href="{{presentation.body}}" width="520" height="387" clip-path="url(#{{clipId}}-body)" aria-hidden="true"/>
            <path class="rm-ammo-cutaway" d="{{presentation.windowPath}}" aria-hidden="true"/>
            {{/if}}
            {{#if presentation.isTube}}<rect class="rm-ammo-tube-frame" x="84" y="18" width="32" height="286" rx="12"/><rect class="rm-ammo-tube-inner" x="88" y="30" width="24" height="264" rx="8"/>{{/if}}
            <g {{#if presentation.isCurved}}clip-path="url(#{{clipId}}-window)"{{/if}}>
              {{#each cells}}
              <g class="rm-ammo-mag-group rm-ammo-tone-{{tone}} {{#if selected}}is-selected{{/if}}" data-ammo-group="{{index}}" data-ammo-action="select" data-index="{{index}}" role="button" tabindex="0" aria-disabled="{{locked}}" aria-label="Ячейка {{number}}: {{name}}, {{count}} из {{size}}">
                {{#each slots}}
                {{#if @root.presentation.isGrid}}
                {{#if @root.presentation.isMuzzle}}<circle class="rm-ammo-bore" cx="{{x}}" cy="{{y}}" r="{{boreRadius}}"/>
                {{else}}<rect class="rm-ammo-chamber" x="{{frameLeft}}" y="-48" width="{{frameWidth}}" height="96" rx="24" transform="translate({{x}} {{y}})"/>{{/if}}
                {{/if}}
                {{/each}}
                <path class="rm-ammo-band" d="{{bandPath}}"/>
                {{#each slots}}
                <g transform="translate({{x}} {{y}}) rotate({{angle}})" class="rm-ammo-slot {{#unless loaded}}is-empty{{/unless}}">
                  <svg x="{{left}}" y="{{top}}" width="{{width}}" height="{{height}}" viewBox="{{@root.presentation.sprite.viewBox}}" class="rm-ammo-round" aria-hidden="true">
                    <image href="{{@root.presentation.sprite.url}}" width="{{@root.presentation.sprite.width}}" height="{{@root.presentation.sprite.height}}"/>
                  </svg>
                </g>
                {{/each}}
              </g>
              {{/each}}
            </g>
          </svg>
        </div>
        <p class="rm-ammo-selection"><i class="fa-solid fa-crosshairs"></i> Выбрана ячейка {{selectedGroupNumber}} <span>Выбери ячейку и боеприпас или перетащи его сюда</span></p>
      </section>
      <section class="rm-ammo-stock-list" aria-label="Доступные боеприпасы">
        <div class="rm-ammo-section-title"><h3>Боеприпасы</h3><span>Свободный запас</span></div>
        <div class="rm-ammo-stock-scroll">
          {{#each stock}}
          <article class="rm-ammo-stock rm-ammo-tone-{{tone}}" draggable="true" data-ammo-key="{{key}}" aria-label="{{name}}, доступно {{remaining}}">
            <img src="{{img}}" alt="" draggable="false"><div class="rm-ammo-stock-info"><strong>{{name}}</strong><span>Доступно: <b>{{remaining}}</b></span>
              {{#if bonus}}<small class="rm-ammo-bonus">{{bonus}} · один раз на атаку</small>{{/if}}
              {{#if manual}}<small class="rm-ammo-manual">Вручную: {{manual}}</small>{{/if}}
            </div>
            <div class="rm-ammo-stock-actions"><button type="button" data-ammo-action="place" data-key="{{key}}">В ячейку</button><button type="button" data-ammo-action="fill" data-key="{{key}}" {{#if empty}}disabled{{/if}}>Заполнить остаток</button></div>
          </article>
          {{else}}<p class="rm-ammo-empty-stock"><i class="fa-solid fa-box-open"></i> В инвентаре нет совместимых патронов.</p>{{/each}}
        </div>
      </section>
    </div>
    {{#if hasLegacy}}<div class="rm-ammo-legacy"><i class="fa-solid fa-circle-question"></i><div><strong>Укажите уже заряженные боеприпасы</strong>
      <span>{{#if hasSavedLegacy}}В старой записи оружия сохранено только количество: {{legacyCount}}. Тип нужен, чтобы правильно вернуть их в инвентарь при разрядке или замене.{{else}}У выбранных патронов импланта не записан тип. Их спецэффекты нужно учитывать вручную.{{/if}}</span>
      {{#if canResolve}}<label>В оружии сейчас <select data-ammo-resolve><option value="">Выберите боеприпас</option>{{#each resolveChoices}}<option value="{{key}}">{{name}}</option>{{/each}}</select></label>{{/if}}
    </div></div>{{/if}}
    <div class="rm-ammo-presets">
      <label>Пресет<select data-ammo-preset><option value="">Выберите схему</option>{{#each presets}}<option value="{{index}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <button type="button" data-ammo-action="delete" title="Удалить выбранный пресет" aria-label="Удалить выбранный пресет"><i class="fa-solid fa-trash-can"></i></button>
      <input data-ammo-preset-name maxlength="80" aria-label="Название пресета" placeholder="Название схемы">
      <button type="button" data-ammo-action="save">Сохранить схему</button>
    </div>
    <p class="hint"><i class="fa-solid fa-circle-info"></i> До подтверждения меняется только черновик. Сложные спецэффекты применяются вручную.</p>
    <footer><button type="button" data-ammo-action="cancel">Отмена</button><button type="button" data-ammo-action="clear">Разрядить</button><button type="button" class="rm-ammo-last" data-ammo-action="last" {{#unless hasLast}}disabled{{/unless}}>Зарядить как в прошлый раз</button><button type="button" class="rm-ammo-confirm" data-ammo-action="load">{{#if busy}}Сохранение…{{else}}{{#if unloading}}Подтвердить разрядку{{else}}Зарядить{{/if}}{{/if}}</button></footer>
  </fieldset>
</div>
