{{#if hasError}}
  <section class="rm-shell rm-trader-v2-shell rm-trader-v2-shell--error scrollable">
    <p class="rm-empty">{{errorMessage}}</p>
  </section>
{{else}}
  <section class="rm-shell rm-trader-v2-shell scrollable">
    <img class="rm-trader-v2-texture" src="{{traderTexturePath}}" alt="" aria-hidden="true" draggable="false">
    <button type="button" class="rm-trader-v2-close" data-action="close-trader-v2" aria-label="Закрыть лавку">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <div class="rm-trader-v2-frame" aria-hidden="true"></div>

    <header class="rm-trader-v2-topline" aria-label="Статус лавки">
      <div class="rm-trader-v2-route">
        <span class="rm-trader-v2-status-dot"></span>
        <span>Город / {{trader.cityName}}</span>
        <span>/</span>
        <span>{{trader.cityState}}</span>
        <span class="rm-trader-v2-sector">Ранг {{rmNum trader.cityRank precision=0}}</span>
      </div>
      <div class="rm-trader-v2-op">Владелец / {{trader.merchantName}}</div>
    </header>

    <section class="rm-trader-v2-brand" aria-label="Название лавки">
      <p class="rm-trader-v2-kicker">Лавка города {{trader.cityName}}</p>
      <h1>{{trader.name}}</h1>
      <p class="rm-trader-v2-subtitle">
        {{trader.merchantName}}{{#if trader.merchantRole}} · {{trader.merchantRole}}{{/if}}
      </p>
      <p class="rm-trader-v2-subtitle">{{trader.cityRegion}} · открытая торговая книга</p>
      <div class="rm-trader-v2-signal" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </section>

    <div class="rm-trader-v2-character-wrap" data-action="poke-trader-character" tabindex="0" aria-label="{{traderSpeech}}">
      <img class="rm-trader-v2-character" src="{{traderArtPath}}" alt="{{trader.merchantName}}">
    </div>
    <div class="rm-trader-v2-character-tooltip" role="tooltip">
      <strong>{{trader.merchantName}}</strong>
      <span>{{traderSpeech}}</span>
    </div>

    <aside class="rm-trader-v2-wallet" aria-label="Кошелёк">
      <span class="rm-trader-v2-wallet__label">Кошелёк</span>
      {{#if trader.customer}}
        <strong>{{trader.customer.currencyLabel}}</strong>
        <small>{{trader.customer.name}}</small>
      {{else}}
        <strong>нет кошелька</strong>
        <small>Получатель будет выбран при покупке</small>
      {{/if}}
      <label class="rm-trader-v2-shared-funds">
        <input type="checkbox" data-action="toggle-shared-funds" {{#if usePartyFunds}}checked{{/if}}>
        <span>Использовать общие средства</span>
      </label>
    </aside>

    <section class="rm-trader-v2-stage">
      <aside class="rm-trader-v2-list-panel {{#if mode.isSell}}is-sell{{else}}is-buy{{/if}}" aria-label="Ассортимент лавки">
        <div class="rm-trader-v2-mode" role="group" aria-label="Режим торговли">
          <button
            type="button"
            class="rm-trader-v2-tab {{#if mode.isBuy}}is-active{{/if}}"
            data-action="switch-mode"
            data-mode="buy"
          >
            <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
            Покупка
          </button>
          <button
            type="button"
            class="rm-trader-v2-tab {{#if mode.isSell}}is-active{{/if}}"
            data-action="switch-mode"
            data-mode="sell"
          >
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            Продажа
          </button>
        </div>

        <div class="rm-trader-v2-controls rm-trader-v2-controls--single">
          <label class="rm-trader-v2-field">
            <span>Поиск по лавке</span>
            <input
              type="text"
              value="{{search}}"
              placeholder="Название, материал, тип"
              data-action="search"
            >
          </label>
        </div>

        {{#if mode.isSell}}
          <div class="rm-trader-v2-dropzone" data-action="sale-dropzone">
            <strong>Продажа через инвентарь</strong>
            <p>Перетащите предмет из листа персонажа сюда. Окно продажи покажет оригинальную цену, текущую цену города, налог и выплату.</p>
          </div>
        {{/if}}

        {{#if emptyInventory}}
          <p class="rm-empty">По текущему фильтру товары не найдены.</p>
        {{else}}
          <div class="rm-trader-v2-list">
            {{#each inventory}}
              <button
                type="button"
                class="rm-trader-v2-row {{#if isSelected}}is-selected{{/if}}"
                data-action="select-item"
                data-item-key="{{itemKey}}"
                aria-pressed="{{#if isSelected}}true{{else}}false{{/if}}"
              >
                <span class="rm-trader-v2-row__icon">
                  {{#if img}}
                    <img src="{{img}}" alt="">
                  {{else}}
                    <i class="fa-solid fa-cube" aria-hidden="true"></i>
                  {{/if}}
                </span>
                <span class="rm-trader-v2-row__name">{{name}}</span>
                <span class="rm-trader-v2-row__meta" {{#if itemTypeTooltip}}title="{{itemTypeTooltip}}{{#if materialTooltip}} {{materialTooltip}}{{/if}}"{{/if}}>
                  {{#if itemTypeLabel}}{{itemTypeLabel}}{{else}}Товар{{/if}}{{#if materialLabel}} · {{materialLabel}}{{/if}}
                </span>
                <span class="rm-trader-v2-row__qty">{{rmNum quantity precision=0}} шт.</span>
                <span class="rm-trader-v2-row__price">{{finalPriceLabel}}</span>
              </button>
            {{/each}}
          </div>
        {{/if}}
      </aside>
    </section>


    {{#unless emptyInventory}}
      <div class="rm-trader-v2-item-deck" data-role="item-deck">
        {{#each inventory}}
          <section
            class="rm-trader-v2-item-card {{#if isSelected}}is-active{{else}}is-hidden{{/if}}"
            data-item-card="{{itemKey}}"
            {{#unless isSelected}}hidden{{/unless}}
            aria-live="polite"
          >
            <div class="rm-trader-v2-item-card__head">
              {{#if img}}
                <img class="rm-trader-v2-item-card__image" src="{{img}}" alt="">
              {{else}}
                <span class="rm-trader-v2-item-card__image rm-trader-v2-item-card__image--fallback">
                  <i class="fa-solid fa-cube" aria-hidden="true"></i>
                </span>
              {{/if}}
              <div>
                <span>&#1042;&#1099;&#1073;&#1088;&#1072;&#1085;&#1085;&#1099;&#1081; &#1090;&#1086;&#1074;&#1072;&#1088;</span>
                <h2>{{name}}</h2>
              </div>
              <strong>{{finalPriceLabel}}</strong>
              <button
                type="button"
                class="rm-trader-v2-item-card__close"
                data-action="clear-selected-item"
                aria-label="&#1047;&#1072;&#1082;&#1088;&#1099;&#1090;&#1100; &#1082;&#1072;&#1088;&#1090;&#1086;&#1095;&#1082;&#1091; &#1090;&#1086;&#1074;&#1072;&#1088;&#1072;"
              >&times;</button>
            </div>

            <div class="rm-trader-v2-item-card__meta">
              <span>&#1054;&#1089;&#1090;&#1072;&#1090;&#1086;&#1082;: {{rmNum quantity precision=0}} &#1096;&#1090;.</span>
              {{#if itemTypeLabel}}<span class="rm-trader-v2-meta-chip rm-tooltip-anchor" data-rm-tooltip="{{itemTypeTooltip}}">{{itemTypeLabel}}</span>{{/if}}
              {{#if materialLabel}}<span class="rm-trader-v2-meta-chip rm-tooltip-anchor" data-rm-tooltip="{{materialTooltip}}">{{materialLabel}}</span>{{/if}}
              {{#if rank}}<span class="rm-trader-v2-meta-chip rm-tooltip-anchor" data-rm-tooltip="{{rankTooltip}}">&#1056;&#1072;&#1085;&#1075; {{rmNum rank precision=0}}</span>{{/if}}
            </div>

            <div class="rm-trader-v2-deal">
              <label class="rm-trader-v2-deal__quantity">
                <span>&#1050;&#1086;&#1083;&#1080;&#1095;&#1077;&#1089;&#1090;&#1074;&#1086;</span>
                <input
                  type="number"
                  min="1"
                  max="{{quantity}}"
                  step="1"
                  value="{{#if isSelected}}{{../selectedQuote.quantity}}{{else}}1{{/if}}"
                  data-action="purchase-quantity"
                  data-item-key="{{itemKey}}"
                  data-max="{{quantity}}"
                  data-unit-price-copper="{{finalPriceCopper}}"
                  data-unit-price-label="{{finalPriceLabel}}"
                >
              </label>
              <div class="rm-trader-v2-deal__total">
                <span>&#1048;&#1090;&#1086;&#1075;&#1086;</span>
                <strong data-role="purchase-total">{{#if isSelected}}{{../selectedQuote.totalLabel}}{{else}}{{finalPriceLabel}}{{/if}}</strong>
                <small data-role="purchase-unit-summary">&#1079;&#1072; {{#if isSelected}}{{../selectedQuote.quantity}}{{else}}1{{/if}} &#1096;&#1090;. &middot; {{finalPriceLabel}} &#1079;&#1072; &#1096;&#1090;&#1091;&#1082;&#1091;</small>
              </div>
            </div>

            {{#if description}}
              <p class="rm-trader-v2-item-card__description">{{description}}</p>
            {{else}}
              <p class="rm-trader-v2-item-card__description">&#1054;&#1087;&#1080;&#1089;&#1072;&#1085;&#1080;&#1077; &#1090;&#1086;&#1074;&#1072;&#1088;&#1072; &#1085;&#1077; &#1079;&#1072;&#1087;&#1086;&#1083;&#1085;&#1077;&#1085;&#1086;. &#1054;&#1090;&#1082;&#1088;&#1086;&#1081;&#1090;&#1077; &#1079;&#1072;&#1087;&#1080;&#1089;&#1100; &#1087;&#1088;&#1077;&#1076;&#1084;&#1077;&#1090;&#1072; &#1076;&#1083;&#1103; &#1087;&#1086;&#1076;&#1088;&#1086;&#1073;&#1085;&#1086;&#1089;&#1090;&#1077;&#1081;.</p>
            {{/if}}

            <div class="rm-trader-v2-item-card__actions">
              {{#if canOpenEntry}}
                <button
                  type="button"
                  class="rm-trader-v2-action rm-trader-v2-action--ghost"
                  data-action="open-compendium-entry"
                  data-source-type="{{sourceType}}"
                  data-source-id="{{sourceId}}"
                  data-source-name="{{name}}"
                >&#1054;&#1090;&#1082;&#1088;&#1099;&#1090;&#1100; &#1079;&#1072;&#1087;&#1080;&#1089;&#1100;</button>
              {{/if}}
              <button
                type="button"
                class="rm-trader-v2-action rm-trader-v2-action--primary"
                data-action="buy-selected"
                data-item-key="{{itemKey}}"
                data-quantity="{{#if isSelected}}{{../selectedQuote.quantity}}{{else}}1{{/if}}"
                title="{{#unless ../canBuyAnyItem}}{{../buyDisabledReason}}{{else}}&#1050;&#1091;&#1087;&#1080;&#1090;&#1100; &#1074;&#1099;&#1073;&#1088;&#1072;&#1085;&#1085;&#1099;&#1081; &#1090;&#1086;&#1074;&#1072;&#1088;{{/unless}}"
                {{#unless ../canBuyAnyItem}}disabled{{/unless}}
              >&#1050;&#1091;&#1087;&#1080;&#1090;&#1100;</button>
            </div>
          </section>
        {{/each}}
      </div>
    {{/unless}}

    {{#if mode.isSell}}
      <section class="rm-trader-v2-sale-overlay" data-role="sale-overlay" aria-label="Продажа предметов">
        <div class="rm-trader-v2-sale-window">
          <header class="rm-trader-v2-sale-header">
            <div>
              <span>Sell</span>
              <h2>Продажа</h2>
            </div>
            <p>{{#if sale.seller}}{{sale.seller.name}}{{else}}Инвентарь не выбран{{/if}}</p>
            <button type="button" data-action="close-sale-overlay" aria-label="Закрыть окно продажи">×</button>
          </header>

          <div class="rm-trader-v2-sale-body">
            <section class="rm-trader-v2-sale-inventory">
              <div class="rm-trader-v2-sale-controls">
                <label>
                  <span>Инвентарь</span>
                  <select data-action="sale-select-seller">
                    {{#each sale.sellerOptions}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label>
                  <span>Поиск</span>
                  <input type="text" value="{{sale.search}}" placeholder="Название, тип, материал" data-action="sale-search">
                </label>
              </div>

              <div class="rm-trader-v2-sale-list">
                <p class="rm-trader-v2-sale-empty" data-role="sale-inventory-empty" {{#unless sale.empty}}hidden{{/unless}}>
                  В этом инвентаре нет предметов для продажи.
                </p>
                {{#each sale.itemGroups}}
                  <div class="rm-trader-v2-sale-group" data-sale-group>
                    <div class="rm-trader-v2-sale-group__header">
                      <span>{{label}}</span>
                      <strong>{{count}}</strong>
                    </div>
                    {{#each items}}
                      <button
                        type="button"
                        class="rm-trader-v2-sale-row"
                        data-action="sale-add-item"
                        data-item-uuid="{{uuid}}"
                        data-sale-inventory-item
                        data-search="{{name}} {{typeLabel}} {{itemTypeLabel}} {{materialLabel}}"
                      >
                        <img src="{{img}}" alt="">
                        <span class="rm-trader-v2-sale-row__name">{{name}}</span>
                        <span class="rm-trader-v2-sale-row__meta">{{itemTypeLabel}}{{#if materialLabel}} · {{materialLabel}}{{/if}}</span>
                        <span class="rm-trader-v2-sale-row__qty">×{{rmNum quantity precision=0}}</span>
                        <strong>{{priceLabel}}</strong>
                      </button>
                    {{/each}}
                  </div>
                {{/each}}
              </div>
            </section>

            <aside class="rm-trader-v2-sale-basket-panel" data-role="sale-basket-panel">
              <div class="rm-trader-v2-sale-basket-head">
                <span>Выбрано к продаже</span>
                <strong data-role="sale-total-net">0 мм</strong>
              </div>
              <p class="rm-trader-v2-sale-empty" data-role="sale-basket-empty">
                Нажмите предмет слева, чтобы добавить его в продажу.
              </p>
              <div class="rm-trader-v2-sale-basket" data-role="sale-basket"></div>
              <footer class="rm-trader-v2-sale-total">
                <div><span>Оригинал</span><strong data-role="sale-total-gross">0 мм</strong></div>
                <div><span>Налог</span><strong data-role="sale-total-tax">0 мм</strong></div>
                <div class="rm-trader-v2-sale-total__net"><span>Итого</span><strong data-role="sale-total-net">0 мм</strong></div>
                <button type="button" class="rm-trader-v2-sale-confirm" data-action="sale-confirm" disabled>
                  Подтвердить продажу
                </button>
              </footer>
            </aside>
          </div>
        </div>
      </section>
    {{/if}}

    <footer class="rm-trader-v2-footer" aria-hidden="true">
      <span><kbd>↑↓</kbd> Навигация</span>
      <span><kbd>↵</kbd> Выбор</span>
      <span><kbd>ESC</kbd> Закрыть</span>
      <strong>Торговая книга Rebreya</strong>
    </footer>
  </section>
{{/if}}
