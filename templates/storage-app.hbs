<section class="rm-shell rm-app-shell rm-storage-shell">
  {{#if hasBreadcrumbs}}
    <nav class="rm-storage-breadcrumbs" aria-label="Путь контейнера">
      {{#each breadcrumbs}}
        <button type="button" data-action="storage-breadcrumb" data-index="{{index}}" aria-current="{{#if current}}page{{else}}false{{/if}}">{{name}}</button>
        {{#unless current}}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>{{/unless}}
      {{/each}}
    </nav>
  {{/if}}
  {{#if configuration.enabled}}
    <form class="rm-storage-config">
      <div class="rm-field">
        <label>Название</label>
        <input type="text" name="baseName" value="{{configuration.baseName}}">
      </div>
      <div class="rm-field">
        <label>Шаблон Lootgen</label>
        <select name="templateId" data-action="storage-select-template">
          <option value="">Без шаблона</option>
          {{#each configuration.templateOptions}}
            <option value="{{id}}">{{name}}</option>
          {{/each}}
        </select>
      </div>
      {{#if configuration.selectedTemplateName}}
        <p class="rm-muted">Сохранённый снимок: {{configuration.selectedTemplateName}}</p>
      {{/if}}
      <label class="rm-storage-config__toggle">
        <input type="checkbox" name="mixGeneratedLoot" {{#if configuration.mixGeneratedLoot}}checked{{/if}}>
        <span>Подмешивать случайный лут</span>
      </label>
      <section class="rm-storage-trigger-summary">
        <div><strong>Триггеры</strong><span>{{configuration.triggerActiveCount}} активных цепочек</span></div>
        <button type="button" class="rm-button rm-button--secondary" data-action="storage-open-trigger-editor"><i class="fa-solid fa-bolt"></i><span>Открыть редактор</span></button>
        <button type="button" class="rm-icon-button" data-action="storage-reset-triggers" aria-label="Сбросить срабатывания"><i class="fa-solid fa-rotate-left"></i></button>
      </section>
      {{#if configuration.canSetTexture}}
        <fieldset class="rm-storage-texture-modes">
          <legend>Внешний вид</legend>
          <div class="rm-storage-texture-modes__buttons">
            {{#each configuration.textureModes}}
              <button
                type="button"
                class="rm-button rm-button--secondary rm-storage-texture-mode{{#if active}} is-active{{/if}}"
                data-action="storage-set-texture"
                data-mode="{{mode}}"
                aria-pressed="{{active}}"
              >
                <span class="rm-storage-texture-mode__number">{{number}}</span>
                <span>{{label}}</span>
              </button>
            {{/each}}
          </div>
        </fieldset>
      {{/if}}
      <div class="rm-storage-config__actions">
        <button type="button" class="rm-button rm-button--primary" data-action="storage-save-config">
          <i class="fa-solid fa-floppy-disk"></i><span>Сохранить настройки</span>
        </button>
        {{#if configuration.canReset}}
          <button type="button" class="rm-button rm-button--secondary" data-action="storage-reset">
            <i class="fa-solid fa-rotate-left"></i><span>Сбросить содержимое</span>
          </button>
        {{/if}}
      </div>
      {{#if configuration.canAddManualItems}}
        <div class="rm-storage-dropzone" data-storage-dropzone>
          <i class="fa-solid fa-hand-pointer"></i>
          <span>Перетащите сюда предмет, чтобы добавить его вручную</span>
        </div>
        {{#each configuration.manualRows}}
          <div class="rm-storage-manual-row">
            <span>{{name}} ×{{quantity}}</span>
            <button type="button" class="rm-icon-button" data-action="storage-remove-manual-item" data-row-id="{{rowId}}" aria-label="Убрать предмет">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        {{/each}}
      {{/if}}
    </form>
  {{/if}}

  {{#if hasGridItems}}
    <div class="rm-storage-grid" style="--rm-storage-columns: {{gridColumns}};">
      {{#each rows}}
        <article class="rm-storage-item" {{#if canDrag}}draggable="true" data-storage-row-drag{{/if}} data-storage-row data-row-id="{{rowId}}">
          <button
            type="button"
            class="rm-storage-item__icon rm-tooltip-anchor"
            data-action="{{primaryAction}}"
            data-rm-tooltip="{{name}}"
            data-row-id="{{rowId}}"
            aria-expanded="{{active}}"
            aria-label="Открыть действия: {{name}}"
          >
            {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-box rm-storage-item__placeholder"></i>{{/if}}
            {{#if showQuantity}}<strong class="rm-storage-item__quantity">{{quantity}}</strong>{{/if}}
          </button>
        </article>
      {{/each}}
      {{#if hasCoins}}
        <article class="rm-storage-item rm-storage-item--coins" data-row-id="__coins">
          <button type="button" class="rm-storage-item__icon" data-action="storage-toggle-coins" aria-expanded="{{coinsExpanded}}" aria-label="Открыть монеты: {{coinsLabel}}">
            <i class="fa-solid fa-coins rm-storage-item__placeholder"></i>
          </button>
        </article>
      {{/if}}

      {{#if activePopover}}
    <div
      class="rm-storage-popover-layer"
      data-storage-popover-layer
      style="--rm-storage-popover-anchor-column: {{activePopover.anchorColumn}}; --rm-storage-popover-anchor-row: {{activePopover.anchorRow}};"
    >
      <div class="rm-storage-item__popover rm-storage-item__popover--{{activePopover.popoverAlignment}}" data-storage-popover data-anchor-row-id="{{activePopover.anchorRowId}}">
        <button type="button" class="rm-storage-item__popover-close" data-action="storage-close-popover" aria-label="Закрыть">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        {{#if activePopover.isCoins}}
          <strong class="rm-storage-item__name rm-storage-item__name--plain">{{activePopover.name}}</strong>
          <div class="rm-storage-item__actions">
            <button type="button" class="rm-button rm-button--primary" data-action="storage-claim-coins-self">Себе</button>
            <button type="button" class="rm-button rm-button--secondary" data-action="storage-claim-coins-party">В группу</button>
          </div>
        {{else}}
          {{#if activePopover.isJournal}}
            <strong class="rm-storage-item__name rm-storage-item__name--plain">{{activePopover.name}}</strong>
            <span class="rm-muted">{{activePopover.typeLabel}}</span>
            <div class="rm-storage-item__actions">
              <button type="button" class="rm-button rm-button--primary" data-action="storage-read-journal" data-row-id="{{activePopover.rowId}}">Прочитать</button>
              {{#if activePopover.canDelete}}
                <button type="button" class="rm-icon-button" data-action="storage-delete-row" data-row-id="{{activePopover.rowId}}" aria-label="Удалить запись"><i class="fa-solid fa-trash"></i></button>
              {{/if}}
            </div>
          {{else}}
          {{#if activePopover.isContainer}}
            <button type="button" class="rm-storage-item__name" data-action="storage-open-container" data-row-id="{{activePopover.rowId}}">{{activePopover.name}}</button>
          {{else if activePopover.canOpenSource}}
            <button type="button" class="rm-storage-item__name" data-action="storage-open-item" data-row-id="{{activePopover.rowId}}">{{activePopover.name}}</button>
          {{else}}
            <strong class="rm-storage-item__name rm-storage-item__name--plain">{{activePopover.name}}</strong>
          {{/if}}
          <span class="rm-muted">{{activePopover.typeLabel}}</span>
          {{#if activePopover.canClaim}}
            <div class="rm-storage-item__actions">
              <button type="button" class="rm-button rm-button--primary" data-action="storage-claim-self" data-row-id="{{activePopover.rowId}}">Себе</button>
              <button type="button" class="rm-button rm-button--secondary" data-action="storage-claim-party" data-row-id="{{activePopover.rowId}}">В группу</button>
            </div>
          {{/if}}
          {{#if activePopover.canEdit}}
            <div class="rm-storage-item__edit" data-storage-row data-row-id="{{activePopover.rowId}}">
              <input data-storage-quantity data-row-id="{{activePopover.rowId}}" type="number" min="1" step="1" value="{{activePopover.quantity}}" aria-label="Количество" {{#if activePopover.isContainer}}disabled{{/if}}>
              {{#if activePopover.canToggleBroken}}
                <label class="rm-storage-item__broken-toggle"><input data-storage-broken data-row-id="{{activePopover.rowId}}" type="checkbox" {{#if activePopover.broken}}checked{{/if}}>Сломано</label>
              {{/if}}
              {{#unless activePopover.isContainer}}
                <button type="button" class="rm-icon-button" data-action="storage-update-row" data-row-id="{{activePopover.rowId}}" aria-label="Сохранить количество"><i class="fa-solid fa-check"></i></button>
              {{/unless}}
              <button type="button" class="rm-icon-button" data-action="storage-delete-row" data-row-id="{{activePopover.rowId}}" aria-label="Удалить предмет"><i class="fa-solid fa-trash"></i></button>
            </div>
          {{/if}}
          {{/if}}
        {{/if}}
      </div>
    </div>
      {{/if}}
    </div>
  {{else}}
    <div class="rm-storage-empty" aria-label="Пусто">
      <i class="fa-solid fa-box-open" aria-hidden="true"></i>
    </div>
  {{/if}}

  {{#if canClaimAll}}
    <div class="rm-storage-claim-all-footer">
      <button
        type="button"
        class="rm-button rm-button--primary rm-storage-claim-all-button"
        data-action="storage-claim-all"
        {{#if claimAllPending}}disabled{{/if}}
      >
        <i class="fa-solid fa-hand" aria-hidden="true"></i>
        <span>Забрать всё</span>
      </button>
    </div>
  {{/if}}
</section>
