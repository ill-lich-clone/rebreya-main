<section class="rebreya-craftsman-archetypes">
  <h3 class="rebreya-craftsman-archetypes__title">{{ title }}</h3>
  <div class="pills-lg rebreya-craftsman-archetypes__rows">
    {{#if research.selected}}
      <div
        class="pill-lg rebreya-craftsman-archetypes__row is-selected"
        data-action="openCraftsmanArchetype"
        data-item-id="{{research.itemId}}"
        data-uuid="{{research.itemUuid}}"
        role="button"
        tabindex="0"
      >
        <span class="rebreya-craftsman-archetypes__axis">{{ research.label }}</span>
        <span class="rebreya-craftsman-archetypes__name">{{ research.name }}</span>
        <span class="rebreya-craftsman-archetypes__level">Уровень {{ research.requiredLevel }}</span>
      </div>
    {{else}}
      <div class="pill-lg rebreya-craftsman-archetypes__row is-empty">
        <span class="rebreya-craftsman-archetypes__axis">{{ research.label }}</span>
        <span class="rebreya-craftsman-archetypes__name">Не выбрано</span>
        <span class="rebreya-craftsman-archetypes__level">Уровень {{ research.requiredLevel }}</span>
      </div>
    {{/if}}

    {{#if specialty.selected}}
      <div
        class="pill-lg rebreya-craftsman-archetypes__row is-selected"
        data-action="openCraftsmanArchetype"
        data-item-id="{{specialty.itemId}}"
        data-uuid="{{specialty.itemUuid}}"
        role="button"
        tabindex="0"
      >
        <span class="rebreya-craftsman-archetypes__axis">{{ specialty.label }}</span>
        <span class="rebreya-craftsman-archetypes__name">{{ specialty.name }}</span>
        <span class="rebreya-craftsman-archetypes__level">Уровень {{ specialty.requiredLevel }}</span>
      </div>
    {{else}}
      <div class="pill-lg rebreya-craftsman-archetypes__row is-empty">
        <span class="rebreya-craftsman-archetypes__axis">{{ specialty.label }}</span>
        <span class="rebreya-craftsman-archetypes__name">Не выбрано</span>
        <span class="rebreya-craftsman-archetypes__level">Уровень {{ specialty.requiredLevel }}</span>
      </div>
    {{/if}}
  </div>
</section>
