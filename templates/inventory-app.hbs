{{#if hasError}}
  <section class="rm-shell rm-inventory-shell scrollable">
    <p class="rm-empty">{{errorMessage}}</p>
  </section>
{{else}}
  <section class="rm-inventory-book">
    <section class="rm-shell rm-inventory-shell rm-inventory-shell--compact rm-inventory-book__page scrollable">
      <header class="rm-inventory-book__header">
        <div class="rm-inventory-book__identity">
          {{#if partyIdentity.canEditCrest}}
            <button
              type="button"
              class="rm-inventory-book__crest-button rm-inventory-book__identity-crest"
              data-action="edit-party-crest"
              title="Изменить герб группы"
              aria-label="Изменить герб группы"
            >
              <img
                class="rm-inventory-book__crest-image"
                src="{{partyIdentity.crestUrl}}"
                alt=""
              >
              <span class="rm-inventory-book__crest-edit" aria-hidden="true">
                <i class="fa-solid fa-pen"></i>
              </span>
            </button>
          {{else}}
            <span class="rm-inventory-book__crest rm-inventory-book__identity-crest">
              <img
                class="rm-inventory-book__crest-image"
                src="{{partyIdentity.crestUrl}}"
                alt=""
              >
            </span>
          {{/if}}

          <div class="rm-inventory-book__heading">
            <h2 class="rm-inventory-book__title">{{partyIdentity.name}}</h2>
            <p class="rm-inventory-book__section-title">{{activeTabLabel}}</p>
          </div>

          <section
            class="rm-currency-compact rm-inventory-book__wallet"
            data-action="edit-currency-root"
            data-currency-pp="{{summary.currency.pp}}"
            data-currency-gp="{{summary.currency.gp}}"
            data-currency-sp="{{summary.currency.sp}}"
            data-currency-cp="{{summary.currency.cp}}"
            aria-label="Монеты группы"
          >
            {{#if canEditCurrency}}
              <button type="button" class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--pp" data-action="edit-currency" title="Редактировать монеты">
                <strong>{{rmNum summary.currency.pp precision=0}}</strong>
                <span>ПМ</span>
              </button>
              <button type="button" class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--gp" data-action="edit-currency" title="Редактировать монеты">
                <strong>{{rmNum summary.currency.gp precision=0}}</strong>
                <span>ЗМ</span>
              </button>
              <button type="button" class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--sp" data-action="edit-currency" title="Редактировать монеты">
                <strong>{{rmNum summary.currency.sp precision=0}}</strong>
                <span>СМ</span>
              </button>
              <button type="button" class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--cp" data-action="edit-currency" title="Редактировать монеты">
                <strong>{{rmNum summary.currency.cp precision=0}}</strong>
                <span>ММ</span>
              </button>
            {{else}}
              <span class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--pp">
                <strong>{{rmNum summary.currency.pp precision=0}}</strong>
                <span>ПМ</span>
              </span>
              <span class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--gp">
                <strong>{{rmNum summary.currency.gp precision=0}}</strong>
                <span>ЗМ</span>
              </span>
              <span class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--sp">
                <strong>{{rmNum summary.currency.sp precision=0}}</strong>
                <span>СМ</span>
              </span>
              <span class="rm-coin-badge rm-inventory-book__panel rm-coin-badge--cp">
                <strong>{{rmNum summary.currency.cp precision=0}}</strong>
                <span>ММ</span>
              </span>
            {{/if}}
          </section>
        </div>

        <div class="rm-inventory-book__controls">
          <div class="rm-inventory-book__actions">
            <button type="button" class="rm-inventory-book__action rm-inventory-book__panel" data-action="open-actor-sheet" title="Открыть лист склада">
              <i class="fa-solid fa-up-right-from-square"></i>
              <span>Лист склада</span>
            </button>
            {{#if canManage}}
              <button type="button" class="rm-inventory-book__action rm-inventory-book__panel" data-action="add-food" title="Добавить еду">
                <i class="fa-solid fa-bread-slice"></i>
                <span>Еда</span>
              </button>
              <button type="button" class="rm-inventory-book__action rm-inventory-book__panel" data-action="add-water" title="Добавить воду">
                <i class="fa-solid fa-droplet"></i>
                <span>Вода</span>
              </button>
            {{/if}}
          </div>

          <section class="rm-inventory-book__summary" aria-label="Сводка партийных запасов">
            <article class="rm-inventory-book__cargo rm-inventory-book__panel">
              <div class="rm-inventory-book__metric-heading">
                <span>Груз</span>
                <strong>{{rmNum party.inventoryWeight}} / {{rmNum party.totalCapacityLb}} фнт.</strong>
              </div>
              <div
                class="rm-inventory-book__cargo-bar"
                tabindex="0"
                aria-describedby="rm-inventory-cargo-tooltip"
                aria-label="Загрузка склада: {{party.dashboard.weight.meterPercent}}%"
              >
                <div class="rm-inventory-book__cargo-fill" style="width: {{party.dashboard.weight.meterPercent}}%;"></div>
                <div class="rm-inventory-book__cargo-tooltip" id="rm-inventory-cargo-tooltip" role="tooltip">
                  <span>
                    <small>Позиций</small>
                    <strong>{{rmNum summary.distinctCount precision=0}}</strong>
                  </span>
                  <span>
                    <small>Единиц</small>
                    <strong>{{rmNum summary.totalQuantity}}</strong>
                  </span>
                  <span>
                    <small>Монеты</small>
                    <strong>{{summary.currencyLabel}}</strong>
                  </span>
                  <span>
                    <small>Свободно</small>
                    <strong>{{rmNum summary.freeCapacityLb}} фнт.</strong>
                  </span>
                </div>
              </div>
            </article>

            <div class="rm-inventory-book__supply-row">
              <article class="rm-inventory-book__supply rm-inventory-book__panel {{party.dashboard.food.className}}">
                <span>Еда</span>
                <strong>{{rmNum summary.foodLb}} фнт.</strong>
                <small>{{party.dashboard.food.daysLabel}}</small>
              </article>
              <article class="rm-inventory-book__supply rm-inventory-book__panel {{party.dashboard.water.className}}">
                <span>Вода</span>
                <strong>{{rmNum summary.waterGal}} гал.</strong>
                <small>{{party.dashboard.water.daysLabel}}</small>
              </article>
              <article class="rm-inventory-book__supply rm-inventory-book__panel">
                <span>Энергия</span>
                <strong>{{party.dashboard.energy.ratioLabel}}</strong>
                <small>{{party.dashboard.energy.note}}</small>
              </article>
            </div>
          </section>
        </div>
      </header>

      <div class="rm-inventory-book__content">

    {{#if groupContextError}}
      <p class="rm-inline-status rm-inline-status--warning">
        <span>{{groupContextError}}</span>
      </p>
    {{/if}}

    {{#if actionFeedback}}
      <p class="{{actionFeedback.className}}">{{actionFeedback.message}}</p>
    {{/if}}

    {{#if tabs.isInventory}}
      <section
        class="rm-panel rm-panel--full rm-panel--compact {{#if canDropInventoryItems}}rm-inventory-drop-surface{{/if}}"
        {{#if canDropInventoryItems}}data-action="inventory-dropzone"{{/if}}
      >
        <div class="rm-inventory-book__inventory-meta">
          <span>{{rmNum inventoryCount precision=0}} поз.</span>
          <span aria-hidden="true">·</span>
          <span>Стоимость вещей: <strong>{{summary.totalItemValueLabel}}</strong></span>
        </div>

        <section class="rm-compact-toolbar">
          <div class="rm-field">
            <input type="search" value="{{search}}" placeholder="Поиск: название, тип, материал" data-action="search">
          </div>
          <div class="rm-field rm-field--narrow">
            <select data-action="type-filter">
              {{#each typeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="rm-field rm-field--narrow">
            <select data-action="sort-mode" aria-label="Сортировка по">
              {{#each sortOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
        </section>

        {{#if emptyInventory}}
          <p class="rm-empty">По текущему фильтру склад пуст.</p>
        {{else}}
          <div class="rm-compact-item-list">
            {{#each inventory}}
              <article
                class="rm-compact-item"
                data-item-drag="true"
                data-item-id="{{itemId}}"
                data-item-name="{{name}}"
                data-item-uuid="{{itemUuid}}"
                data-source-type="{{sourceType}}"
                data-source-id="{{sourceId}}"
                data-source-name="{{sourceName}}"
                data-quantity="{{quantity}}"
                draggable="true"
              >
                <div class="rm-compact-item__main">
                  <img class="rm-compact-item__image" src="{{img}}" alt="{{name}}">
                  <div class="rm-compact-item__copy">
                    <div class="rm-compact-item__title">
                      {{#if canOpenEntry}}
                        <button type="button" class="rm-link-button rm-link-button--accent rm-compact-item__name" data-action="open-compendium-entry" data-source-type="{{sourceType}}" data-source-id="{{sourceId}}" data-source-name="{{name}}">{{name}}</button>
                      {{else}}
                        <strong class="rm-compact-item__name">{{name}}</strong>
                      {{/if}}
                    </div>

                    <p class="rm-compact-item__meta">
                      {{rmNum quantity}} шт.
                      {{#if priceLabel}} • {{priceLabel}}{{/if}}
                      • {{rmNum totalWeight}} фнт.
                      {{#if itemTypeLabel}} • {{itemTypeLabel}}{{/if}}
                      {{#if materialLabel}} • {{materialLabel}}{{/if}}
                    </p>
                  </div>
                </div>

                <div class="rm-compact-item__side">
                  <div class="rm-compact-item__metrics">
                    <p>
                      <span>Кол-во</span>
                      <strong>{{rmNum quantity}}</strong>
                    </p>
                    <p>
                      <span>Вес</span>
                      <strong>{{rmNum totalWeight}} фнт.</strong>
                    </p>
                    <p>
                      <span>Цена</span>
                      <strong>{{#if priceLabel}}{{priceLabel}}{{else}}-{{/if}}</strong>
                    </p>
                  </div>

                  <button type="button" class="rm-icon-button rm-compact-item__menu" data-action="open-item-menu" title="Действия с предметом" aria-label="Действия с предметом">
                    <i class="fa-solid fa-ellipsis"></i>
                  </button>
                  <div class="rm-compact-item__service-actions" hidden>
                    {{#if ../canDropInventoryItems}}
                      <button type="button" data-action="take-item-self" data-item-id="{{itemId}}" data-item-name="{{name}}" data-quantity="{{quantity}}"></button>

                      {{#if canSell}}
                        <button type="button" data-action="sell-item" data-item-id="{{itemId}}" data-item-name="{{name}}" data-quantity="{{quantity}}"></button>
                      {{/if}}

                      <button type="button" data-action="delete-item" data-item-id="{{itemId}}" data-item-name="{{name}}"></button>
                    {{/if}}

                    {{#if ../canManage}}
                      <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="edit-item-quantity" data-item-id="{{itemId}}" data-item-name="{{name}}" data-quantity="{{quantity}}">
                        <i class="fa-solid fa-pen"></i>
                        <span>Изменить количество</span>
                      </button>

                      <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="break-item" data-item-id="{{itemId}}" data-item-name="{{name}}" data-quantity="{{quantity}}">
                        <i class="fa-solid fa-hammer"></i>
                        <span>Разобрать</span>
                      </button>
                    {{/if}}
                  </div>
                </div>
              </article>
            {{/each}}
          </div>
        {{/if}}
      </section>
    {{/if}}

    {{#if tabs.isParty}}
      <section class="rm-panel rm-panel--full rm-panel--compact">
        <div class="rm-panel__header rm-panel__header--compact">
          <h3>Группа</h3>
          <span class="rm-muted">{{rmNum party.memberCount precision=0}} уч.</span>
        </div>

        {{#if party.alerts.length}}
          <div class="rm-status-strip">
            {{#each party.alerts}}
              <span class="rm-badge rm-status-badge rm-status-badge--{{type}}">{{message}}</span>
            {{/each}}
          </div>
        {{/if}}

        {{#if canManage}}
          <section class="rm-party-toolbar rm-party-toolbar--compact" data-action="party-dropzone">
            {{#if party.membershipManagedByNativeGroup}}
              <p class="rm-inline-status rm-inline-status--info">
                <span>Состав управляется обычным листом группы dnd5e. Добавляйте и удаляйте участников там.</span>
              </p>
            {{else}}
              <div class="rm-field">
                <input
                  type="text"
                  value="{{party.addMemberQuery}}"
                  placeholder="{{#if party.addMemberDisabled}}Нет доступных актёров{{else}}Введите имя участника{{/if}}"
                  autocomplete="off"
                  list="{{appDomId}}-party-member-list"
                  data-action="add-member-query"
                  {{#if party.addMemberDisabled}}disabled{{/if}}
                >
                <datalist id="{{appDomId}}-party-member-list">
                  {{#each party.availableActors}}
                    <option value="{{name}}"></option>
                  {{/each}}
                </datalist>
                <small class="rm-muted">Введите имя или перетащите лист персонажа в эту область.</small>
              </div>
            {{/if}}

            {{#unless party.membershipManagedByNativeGroup}}
              <div class="rm-party-toolbar__actions">
                <button
                  type="button"
                  class="rm-button rm-button--small rm-button--primary"
                  data-action="add-member"
                  title="{{#if party.addMemberDisabled}}{{party.addMemberDisabledReason}}{{else}}Добавить участника в группу{{/if}}"
                  {{#if party.addMemberDisabled}}disabled{{/if}}
                >
                  <i class="fa-solid fa-user-plus"></i>
                  <span>Добавить участника</span>
                </button>
              </div>
            {{/unless}}
          </section>
    {{/if}}

        <section class="rm-party-toolbar">
          <div class="rm-party-toolbar__actions">
            <label class="rm-checkbox">
              <input type="checkbox" data-action="party-default-field" data-field="coverFoodExpenses" {{#if party.coverFoodExpenses}}checked{{/if}} {{#unless canManage}}disabled{{/unless}}>
              <span>Покрыть расходы еды</span>
            </label>
            <label class="rm-checkbox">
              <input type="checkbox" data-action="party-default-field" data-field="coverWaterExpenses" {{#if party.coverWaterExpenses}}checked{{/if}} {{#unless canManage}}disabled{{/unless}}>
              <span>Покрыть расходы воды</span>
            </label>
          </div>
        </section>

        {{#if party.emptyMembers}}
          <p class="rm-empty">Группа пока не собрана.</p>
        {{else}}
          <div class="rm-party-member-list rm-party-member-list--compact">
            {{#each party.members}}
              <details class="rm-party-row {{#if isMissing}}rm-party-row--missing{{/if}}" data-actor-id="{{actorId}}" data-actor-name="{{actorName}}" {{#if expanded}}open{{/if}}>
                <summary class="rm-party-row__summary">
                  <div class="rm-party-row__identity">
                    <img class="rm-party-row__image" src="{{actorImg}}" alt="{{actorName}}">
                    <div>
                      <strong>{{actorName}}</strong>
                      <p class="rm-muted">
                        {{roleLabel}}
                        {{#if isMissing}} • лист не найден{{/if}}
                      </p>
                    </div>
                  </div>

                  <div class="rm-party-row__stats">
                    <span class="rm-chip">СИЛ {{rmNum strength precision=0}}</span>
                    <span class="rm-chip">Груз {{rmNum capacityLb}}</span>
                    <span class="rm-chip">Эн. {{rmNum energyCurrent precision=0}} / {{rmNum energyMax precision=0}}</span>
                  </div>
                </summary>

                <div class="rm-party-row__body">
                  <div class="rm-party-row__controls rm-party-row__controls--basic">
                    <div class="rm-field">
                      <label>Роль</label>
                      <select data-action="party-field" data-actor-id="{{actorId}}" data-field="role" {{#unless ../canManage}}disabled{{/unless}}>
                        {{#each roleOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>

                    <div class="rm-field">
                      <label>Еда / день</label>
                      <input type="number" min="0" step="0.01" value="{{foodPerDay}}" data-action="party-field" data-actor-id="{{actorId}}" data-field="foodPerDay" {{#unless ../canManage}}disabled{{/unless}}>
                    </div>

                    <div class="rm-field">
                      <label>Вода / день</label>
                      <input type="number" min="0" step="0.01" value="{{waterGalPerDay}}" data-action="party-field" data-actor-id="{{actorId}}" data-field="waterGalPerDay" {{#unless ../canManage}}disabled{{/unless}}>
                    </div>

                    <div class="rm-field">
                      <label>Энергия</label>
                      <input type="number" min="0" max="{{energyMax}}" step="1" value="{{energyCurrent}}" data-action="party-energy-current" data-actor-id="{{actorId}}" {{#unless ../canManage}}disabled{{/unless}}>
                    </div>
                  </div>

                  <details class="rm-party-row__advanced">
                    <summary class="rm-party-row__advanced-toggle rm-toggle-affordance">Доп. настройки и инструменты</summary>

                    <div class="rm-party-row__controls rm-party-row__controls--advanced">
                      <div class="rm-field">
                      <label>СИЛ override</label>
                       <input type="number" min="0" step="1" value="{{strOverride}}" placeholder="Лист" data-action="party-field" data-actor-id="{{actorId}}" data-field="strOverride" {{#unless ../canManage}}disabled{{/unless}}>
                    </div>

                    <div class="rm-field">
                      <label>Мод. груза</label>
                       <input type="number" min="1" step="0.01" value="{{capModOverride}}" placeholder="{{../party.defaultCapMod}}" data-action="party-field" data-actor-id="{{actorId}}" data-field="capModOverride" {{#unless ../canManage}}disabled{{/unless}}>
                    </div>

                    <div class="rm-field">
                      <label>Бонус груза</label>
                       <input type="number" min="0" step="0.01" value="{{capBonusLb}}" data-action="party-field" data-actor-id="{{actorId}}" data-field="capBonusLb" {{#unless ../canManage}}disabled{{/unless}}>
                    </div>

                    <div class="rm-field">
                      <label>CON override</label>
                       <input type="number" step="1" value="{{conModOverride}}" placeholder="Лист" data-action="party-field" data-actor-id="{{actorId}}" data-field="conModOverride" {{#unless ../canManage}}disabled{{/unless}}>
                    </div>
                    </div>

                    <section class="rm-party-tools">
                      <h4>Инструменты Rebreya</h4>
                      <div class="rm-party-tools__rows">
                        {{#each tools}}
                          <div class="rm-party-tool-row">
                            <span>{{label}}</span>
                            <label><input type="checkbox" data-action="party-tool-field" data-actor-id="{{../actorId}}" data-tool-id="{{toolId}}" data-field="owned" {{#if owned}}checked{{/if}} {{#unless ../../canManage}}disabled{{/unless}}> есть</label>
                            <label><input type="checkbox" data-action="party-tool-field" data-actor-id="{{../actorId}}" data-tool-id="{{toolId}}" data-field="prof" {{#if prof}}checked{{/if}} {{#unless ../../canManage}}disabled{{/unless}}> проф</label>
                            <input type="number" step="0.01" value="{{mod}}" data-action="party-tool-field" data-actor-id="{{../actorId}}" data-tool-id="{{toolId}}" data-field="mod" title="Модификатор" {{#unless ../../canManage}}disabled{{/unless}}>
                          </div>
                        {{/each}}
                      </div>
                    </section>
                  </details>

                  <div class="rm-party-row__footer">
                    <div class="rm-inline-actions">
                      <span class="rm-muted">Источник силы: {{strengthSource}} • CON: {{conMod}} ({{conModSource}})</span>
                      {{#if ../canManage}}
                        <button type="button" class="rm-button rm-button--small rm-button--ghost" data-action="party-restore-energy" data-actor-id="{{actorId}}" data-actor-name="{{actorName}}">Восстановить энергию</button>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </details>
            {{/each}}
          </div>
        {{/if}}
      </section>
    {{/if}}

    {{#if tabs.isCraft}}
      <section class="rm-panel rm-panel--full rm-panel--compact">
        <div class="rm-panel__header rm-panel__header--compact">
          <h3>Крафт</h3>
          <span class="rm-muted">Заявки: {{rmNum craft.pendingRequestCount precision=0}} • Проекты: {{rmNum craft.projectCount precision=0}}</span>
        </div>

        <section class="rm-craft-toolbar">
          <div class="rm-field">
            <label>Поиск проектов</label>
            <input type="search" value="{{craftSearch}}" placeholder="Предмет или персонаж" data-action="craft-search">
          </div>
          <div class="rm-field">
            <label>Крафтит</label>
            <select data-action="craft-crafter">
              {{#if craft.crafters.length}}
                {{#each craft.crafters}}
                  <option value="{{actorId}}" {{#if selected}}selected{{/if}}>{{actorName}}</option>
                {{/each}}
              {{else}}
                <option value="">Нет участников</option>
              {{/if}}
            </select>
          </div>
        </section>

        <div class="rm-craft-layout">
          <section class="rm-craft-column">
            <h4>Заявки игроков</h4>
            {{#if craft.hasPendingRequests}}
              <div class="rm-craft-item-list">
                {{#each craft.pendingRequests}}
                  <article class="rm-craft-item-row">
                    <div>
                      <strong>{{outputLabel}}</strong>
                      <p class="rm-muted">{{actorName}} • {{rmNum workdays precision=0}} раб. дн. • {{rmNum hoursPerDay precision=0}} ч. • {{workshopLabel}}</p>
                    </div>
                    {{#if ../canManage}}
                      <div class="rm-inline-actions">
                        <button type="button" class="rm-icon-button" data-action="craft-approve-request" data-request-id="{{id}}" title="Одобрить проект">
                          <i class="fa-solid fa-check"></i>
                        </button>
                        <button type="button" class="rm-icon-button" data-action="craft-return-request" data-request-id="{{id}}" title="Вернуть игроку">
                          <i class="fa-solid fa-rotate-left"></i>
                        </button>
                        <button type="button" class="rm-icon-button rm-icon-button--danger" data-action="craft-reject-request" data-request-id="{{id}}" title="Отклонить проект">
                          <i class="fa-solid fa-xmark"></i>
                        </button>
                      </div>
                    {{/if}}
                  </article>
                {{/each}}
              </div>
            {{else}}
              <p class="rm-empty">Новых заявок на крафт нет.</p>
            {{/if}}
          </section>

          <section class="rm-craft-column">
            <h4>Проекты</h4>
            {{#if craft.hasProjects}}
              <div class="rm-craft-queue-list">
                {{#each craft.projects}}
                  <article class="rm-craft-queue-row">
                    <div>
                      <strong>{{outputLabel}}</strong>
                      <p class="rm-muted">{{statusLabel}} • {{rmNum hoursPerDay precision=0}} ч. • {{workshopLabel}}</p>
                      <div class="rm-progress">
                        <div class="rm-progress__bar" style="width: {{progressPercent}}%;"></div>
                      </div>
                      <p class="rm-muted">{{rmNum progressPercent}}% • осталось {{rmNum remainingGold}} зм</p>
                    </div>
                    {{#if ../canManage}}
                      <div class="rm-inline-actions">
                        {{#if canPause}}
                          <button type="button" class="rm-icon-button" data-action="craft-pause-project" data-project-id="{{id}}" title="Поставить на паузу"><i class="fa-solid fa-pause"></i></button>
                        {{/if}}
                        {{#if canResume}}
                          <button type="button" class="rm-icon-button" data-action="craft-resume-project" data-project-id="{{id}}" title="Продолжить"><i class="fa-solid fa-play"></i></button>
                        {{/if}}
                        {{#if canReconcile}}
                          <button type="button" class="rm-icon-button" data-action="craft-reconcile-project" data-project-id="{{id}}" title="Сверить проект"><i class="fa-solid fa-scale-balanced"></i></button>
                        {{/if}}
                        {{#if canCancel}}
                          <button type="button" class="rm-icon-button rm-icon-button--danger" data-action="craft-cancel-project" data-project-id="{{id}}" data-project-name="{{outputLabel}}" title="Отменить проект"><i class="fa-solid fa-ban"></i></button>
                        {{/if}}
                      </div>
                    {{/if}}
                  </article>
                {{/each}}
              </div>
            {{else}}
              <p class="rm-empty">Проектов крафта пока нет.</p>
            {{/if}}
          </section>
        </div>
      </section>
    {{/if}}

    {{#if tabs.isTravel}}
      <section class="rm-panel rm-panel--full rm-panel--compact rm-travel-panel">
        <div class="rm-panel__header rm-panel__header--compact">
          <div>
            <h3>Путешествие</h3>
          </div>
          <span class="rm-badge rm-status-badge rm-status-badge--info">{{travel.speedLabel}}</span>
        </div>

        {{#if travel.warning}}
          <p class="rm-inline-status rm-inline-status--warning">
            <span>{{travel.warning}}</span>
          </p>
        {{else}}
          <section class="rm-travel-controls">
            <div class="rm-field">
              <label>Город А</label>
              <div class="rm-travel-city-combobox">
                <input type="search" class="rm-travel-city-input" data-action="travel-origin-query" value="{{travel.originCityName}}" placeholder="Начните вводить город" autocomplete="off" {{#unless travel.canSelectRoute}}disabled{{/unless}}>
                <input type="hidden" data-action="travel-origin" value="{{travel.originCityId}}">
                <div class="rm-travel-city-results" data-travel-city-results="origin" hidden>
                {{#each travel.cityOptions}}
                    <button type="button" class="rm-travel-city-option" data-action="travel-city-option" data-role="origin" data-city-id="{{value}}" data-city-label="{{label}}" data-search="{{searchText}}">
                      <span>{{label}}</span>
                      {{#if subtitle}}<small>{{subtitle}}</small>{{/if}}
                    </button>
                {{/each}}
                </div>
              </div>
            </div>

            <div class="rm-field">
              <label>Город Б</label>
              <div class="rm-travel-city-combobox">
                <input type="search" class="rm-travel-city-input" data-action="travel-destination-query" value="{{travel.destinationCityName}}" placeholder="Начните вводить город" autocomplete="off" {{#unless travel.canSelectRoute}}disabled{{/unless}}>
                <input type="hidden" data-action="travel-destination" value="{{travel.destinationCityId}}">
                <div class="rm-travel-city-results" data-travel-city-results="destination" hidden>
                {{#each travel.cityOptions}}
                    <button type="button" class="rm-travel-city-option" data-action="travel-city-option" data-role="destination" data-city-id="{{value}}" data-city-label="{{label}}" data-search="{{searchText}}">
                      <span>{{label}}</span>
                      {{#if subtitle}}<small>{{subtitle}}</small>{{/if}}
                    </button>
                {{/each}}
                </div>
              </div>
            </div>

            <div class="rm-field rm-field--narrow">
              <label>Путь</label>
              <select data-action="travel-mode" {{#unless travel.canSelectRoute}}disabled{{/unless}}>
                {{#each travel.modeOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </section>

          {{#if travel.plan.available}}
            <section class="rm-travel-summary">
              <div class="rm-travel-route">
                <strong>{{travel.plan.originName}}</strong>
                <i class="fa-solid fa-arrow-right-long"></i>
                <strong>{{travel.plan.destinationName}}</strong>
              </div>

              <div class="rm-travel-stats">
                <p><span>Дистанция</span><strong>{{rmNum travel.plan.totalMiles}} миль</strong></p>
                <p><span>В пути</span><strong>{{rmNum travel.plan.totalTravelDays precision=0}} дн. ({{rmNum travel.plan.totalHours}} ч.)</strong></p>
                <p>
                  <span>Осталось</span>
                  <strong data-travel-remaining-miles>{{rmNum travel.progress.remainingMiles}} миль</strong>
                  <small data-travel-remaining-time>{{rmNum travel.progress.remainingTravelDays precision=0}} дн. ({{rmNum travel.progress.remainingHours}} ч.)</small>
                </p>
              </div>

              <div class="rm-progress rm-travel-progress" data-travel-progress aria-label="{{travel.progress.label}}">
                <div class="rm-progress__bar" data-travel-progress-bar style="width: {{travel.progress.percent}}%;"></div>
                <span class="rm-travel-progress-token" data-travel-progress-token style="left: {{travel.progress.percent}}%;" aria-hidden="true"></span>
              </div>
              <p class="rm-muted" data-travel-progress-label>{{travel.progress.label}} • осталось {{rmNum travel.progress.remainingTravelDays precision=0}} дн. ({{rmNum travel.progress.remainingHours}} ч.)</p>

              <div class="rm-travel-actions">
                <label class="rm-travel-time-toggle">
                  <input type="checkbox" data-action="travel-track-time" {{#if travel.trackTime}}checked{{/if}}>
                  <span>Учитывать время</span>
                </label>
                <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="travel-advance" data-hours="-8" {{#unless travel.canRewind}}disabled{{/unless}}>
                  <i class="fa-solid fa-backward-step"></i>
                  <span>-8 ч.</span>
                </button>
                <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="travel-advance" data-hours="-1" {{#unless travel.canRewind}}disabled{{/unless}}>
                  <i class="fa-solid fa-minus"></i>
                  <span>-1 ч.</span>
                </button>
                <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="travel-advance" data-hours="1" {{#unless travel.canAdvance}}disabled{{/unless}}>
                  <i class="fa-solid fa-plus"></i>
                  <span>1 ч.</span>
                </button>
                <button type="button" class="rm-button rm-button--small rm-button--primary" data-action="travel-advance" data-hours="8" {{#unless travel.canAdvance}}disabled{{/unless}}>
                  <i class="fa-solid fa-forward-step"></i>
                  <span>8 ч.</span>
                </button>
                <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="travel-clear">
                  <i class="fa-solid fa-xmark"></i>
                  <span>Сбросить</span>
                </button>
              </div>
            </section>

            <section class="rm-travel-leg-list">
              {{#each travel.plan.legs}}
                <article class="rm-travel-leg">
                  <button type="button" class="rm-link-button rm-travel-city-link" data-action="travel-open-city" data-city-id="{{sourceCityId}}">{{sourceName}}</button>
                  <i class="fa-solid fa-route"></i>
                  <button type="button" class="rm-link-button rm-travel-city-link" data-action="travel-open-city" data-city-id="{{targetCityId}}">{{targetName}}</button>
                  <strong>{{rmNum miles}} миль</strong>
                </article>
              {{/each}}
            </section>
          {{else}}
            <p class="rm-empty">{{travel.emptyMessage}}</p>
          {{/if}}
        {{/if}}
      </section>
    {{/if}}

    {{#if tabs.isTransport}}
      <section class="rm-panel rm-panel--full rm-panel--compact rm-transport-panel">
        <div class="rm-panel__header rm-panel__header--compact">
          <div>
            <h3>Транспорт</h3>
          </div>
          <span class="rm-badge rm-status-badge rm-status-badge--info">{{transport.speedLabel}}</span>
        </div>

        {{#if transport.warning}}
          <p class="rm-inline-status rm-inline-status--warning">
            <span>{{transport.warning}}</span>
          </p>
        {{else}}
          <section class="rm-transport-overview">
            <article class="rm-transport-summary rm-transport-summary--active">
              <span>Активный транспорт</span>
              {{#if transport.activeVehicle}}
                <strong>{{transport.activeVehicle.name}}</strong>
                <small>{{transport.speedSourceLabel}}</small>
              {{else}}
                <strong>Пешком</strong>
                <small>Выберите транспорт группы, чтобы заменить базовую скорость.</small>
              {{/if}}
            </article>
            <article class="rm-transport-summary">
              <span>Скорость пути</span>
              <strong>{{transport.speedLabel}}</strong>
              <small>{{transport.speedSourceLabel}}</small>
            </article>
            <article class="rm-transport-summary {{#if transport.cargoOverloaded}}rm-negative{{/if}}">
              <span>Грузоподъёмность</span>
              <strong>{{transport.cargoLabel}}</strong>
              <small>{{transport.cargoUsageLabel}} • свободно {{transport.cargoFreeLabel}}</small>
            </article>
            <article class="rm-transport-summary">
              <span>Прочность</span>
              <strong>{{transport.durabilityLabel}}</strong>
              <small>Хиты активного транспорта</small>
            </article>
          </section>

          {{#if transport.hasVehicles}}
            <div class="rm-transport-list">
              {{#each transport.vehicles}}
                <article class="rm-transport-row {{#if active}}is-active{{/if}}">
                  <div class="rm-transport-row__main">
                    <img class="rm-transport-row__image" src="{{img}}" alt="{{name}}">
                    <div class="rm-transport-row__copy">
                      <div class="rm-transport-row__title">
                        <strong>{{name}}</strong>
                        {{#if active}}<span class="rm-badge rm-status-badge rm-status-badge--good">Активен</span>{{/if}}
                      </div>
                      <p class="rm-muted">
                        {{sourceLabel}}
                        {{#if detailsLabel}} • {{detailsLabel}}{{/if}}
                        {{#if quantity}} • {{rmNum quantity}} шт.{{/if}}
                      </p>
                    </div>
                  </div>

                  <div class="rm-transport-row__metrics">
                    <p><span>Скорость</span><strong>{{speedLabel}}</strong></p>
                    <p><span>Груз</span><strong>{{cargoLabel}}</strong></p>
                    <p><span>Хиты</span><strong>{{durabilityLabel}}</strong></p>
                    <p><span>КД</span><strong>{{acLabel}}</strong></p>
                  </div>

                  {{#if ../transport.canManage}}
                    <button
                      type="button"
                      class="rm-button rm-button--small {{#if active}}rm-button--secondary{{else}}rm-button--primary{{/if}}"
                      data-action="transport-select"
                      data-transport-id="{{id}}"
                      {{#if active}}disabled{{/if}}
                    >
                      <i class="fa-solid {{#if active}}fa-check{{else}}fa-location-arrow{{/if}}"></i>
                      <span>{{#if active}}Выбран{{else}}Выбрать{{/if}}</span>
                    </button>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="rm-empty">В группе пока нет транспорта. Положите транспортный предмет в токен или склад группы.</p>
          {{/if}}
        {{/if}}
      </section>
    {{/if}}

    {{#if tabs.isDowntime}}
      <section class="rm-panel rm-panel--full rm-panel--compact rm-downtime-panel">
        <div class="rm-panel__header rm-panel__header--compact">
          <div>
            <h3>Простой</h3>
          </div>
          <span class="rm-badge rm-status-badge rm-status-badge--info">{{rmNum downtime.requests.length precision=0}} заяв.</span>
        </div>

        {{#if downtime.warning}}
          <p class="rm-inline-status rm-inline-status--warning">
            <span>{{downtime.warning}}</span>
          </p>
        {{/if}}

        <div class="rm-downtime-layout">
          <aside class="rm-downtime-column rm-downtime-column--members">
            <header class="rm-downtime-column__header">
              <h4>Участники</h4>
              <span class="rm-muted">{{rmNum downtime.members.length precision=0}} лист.</span>
            </header>

            {{#if downtime.emptyMembers}}
              <p class="rm-empty">В группе пока нет участников для простоя.</p>
            {{else}}
              <div class="rm-downtime-member-list">
                {{#each downtime.members}}
                  <article class="rm-downtime-member">
                    <div class="rm-downtime-member__main">
                      <strong>{{actorName}}</strong>
                      <span class="rm-muted">всего {{rmNum totalGrantedWorkdays precision=0}} раб. дн.</span>
                    </div>
                    <div class="rm-downtime-member__weeks">
                      <strong>{{rmNum availableWorkdays precision=0}}</strong>
                      <span>своб. дн.</span>
                    </div>
                    <p class="rm-downtime-member__meta">рез. {{rmNum reservedWorkdays precision=0}} дн. • потрач. {{rmNum spentWorkdays precision=0}} дн.</p>
                  </article>
                {{/each}}
              </div>
            {{/if}}

            {{#if downtime.canManage}}
              <section class="rm-downtime-grant">
                <h4>Коррекция недель</h4>
                <div class="rm-field">
                  <label>Кому</label>
                  <select data-action="downtime-grant-actor" {{#if downtime.grantDisabled}}disabled{{/if}}>
                    {{#each downtime.grantActorOptions}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="rm-downtime-grant__row">
                  <div class="rm-field rm-field--narrow">
                    <label>Недели</label>
                    <input type="number" min="1" step="1" value="{{downtime.grantWeeks}}" data-action="downtime-grant-weeks" {{#if downtime.grantDisabled}}disabled{{/if}}>
                  </div>
                  <button
                    type="button"
                    class="rm-button rm-button--small rm-button--primary"
                    data-action="downtime-grant"
                    title="{{downtime.grantDisabledReason}}"
                    {{#if downtime.grantDisabled}}disabled{{/if}}
                  >
                    <i class="fa-solid fa-calendar-plus"></i>
                    <span>Выдать</span>
                  </button>
                  <button
                    type="button"
                    class="rm-button rm-button--small rm-button--danger"
                    data-action="downtime-revoke"
                    title="{{downtime.grantDisabledReason}}"
                    {{#if downtime.grantDisabled}}disabled{{/if}}
                  >
                    <i class="fa-solid fa-calendar-minus"></i>
                    <span>Забрать</span>
                  </button>
                </div>
              </section>
            {{/if}}
          </aside>

          <section class="rm-downtime-column rm-downtime-column--queue">
            <header class="rm-downtime-column__header">
              <h4>{{#if downtime.showArchive}}Архив{{else}}Очередь заявок{{/if}}</h4>
              <div class="rm-downtime-column__actions">
                <span class="rm-muted">{{rmNum downtime.visibleRequestCount precision=0}}</span>
                <button
                  type="button"
                  class="rm-icon-button {{#if downtime.showArchive}}is-active{{/if}}"
                  data-action="downtime-toggle-archive"
                  data-tooltip="{{#if downtime.showArchive}}Показать активные заявки{{else}}Показать архив заявок{{/if}}"
                  {{#if downtime.emptyArchiveRequests}}{{#unless downtime.showArchive}}disabled{{/unless}}{{/if}}
                >
                  <i class="fa-solid fa-box-archive"></i>
                </button>
                {{#if downtime.canManage}}
                  <button
                    type="button"
                    class="rm-icon-button rm-icon-button--danger"
                    data-action="downtime-clear-history"
                    data-tooltip="Очистить все заявки, целевые действия и решения мастера. Резерв открытых заявок вернётся в свободные недели."
                    {{#if downtime.emptyVisibleRequests}}disabled{{/if}}
                  >
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                {{/if}}
              </div>
            </header>

            {{#if downtime.emptyVisibleRequests}}
              <p class="rm-empty">Заявок на простой пока нет.</p>
            {{else}}
              <div class="rm-downtime-request-list">
                {{#each downtime.visibleRequests}}
                  <article
                    class="rm-downtime-request {{#if isSelected}}is-selected{{/if}}"
                    data-action="downtime-open-request"
                    data-request-id="{{id}}"
                    role="button"
                    tabindex="0"
                  >
                    <div class="rm-downtime-request__main">
                      <div class="rm-downtime-request__title">
                        <strong>{{displayTitle}}</strong>
                        <span class="rm-badge rm-status-badge {{statusClass}}">{{statusLabel}}</span>
                      </div>
                      <p class="rm-muted">{{actorName}} • {{actionLabel}} • {{rmNum weeks precision=0}} нед.</p>
                      {{#if description}}
                        <p class="rm-downtime-request__description">{{description}}</p>
                      {{/if}}
                      {{#if templateSummary}}
                        <p class="rm-downtime-request__description">{{templateSummary}}</p>
                      {{/if}}
                    </div>

                    {{#if ../downtime.canManage}}
                      <div class="rm-downtime-request__actions">
                        <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="downtime-status" data-request-id="{{id}}" data-status="approved" data-tooltip="Одобрить: оставить недели в резерве и разрешить игроку выполнять целевые действия." {{#unless canApprove}}disabled{{/unless}}>Одобрить</button>
                        <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="downtime-status" data-request-id="{{id}}" data-status="returned" data-result="{{result}}" data-tooltip="Вернуть: снять резерв, вернуть недели игроку и отправить заявку на доработку." {{#unless canReturn}}disabled{{/unless}}>Вернуть</button>
                        <button type="button" class="rm-button rm-button--small rm-button--danger" data-action="downtime-status" data-request-id="{{id}}" data-status="rejected" data-result="{{result}}" data-tooltip="Отклонить: отказать в заявке и вернуть зарезервированные недели." {{#unless canReject}}disabled{{/unless}}>Отклонить</button>
                        <button type="button" class="rm-button rm-button--small rm-button--primary" data-action="downtime-status" data-request-id="{{id}}" data-status="completed" data-result="{{result}}" data-tooltip="Завершить: списать резерв в потраченные недели и закрыть заявку." {{#unless canComplete}}disabled{{/unless}}>Завершить</button>
                        <button
                          type="button"
                          class="rm-button rm-button--small rm-button--secondary"
                          data-action="downtime-target-action"
                          data-request-id="{{id}}"
                          data-tooltip="Добавить целевое действие: проверку, выбор, инструмент, действие или атаку"
                        >
                          <i class="fa-solid fa-plus"></i>
                          <span>Действие</span>
                        </button>
                      </div>
                    {{/if}}
                  </article>
                {{/each}}
              </div>

              {{#if downtime.visiblePage.total}}
                <nav class="rm-downtime-pagination">
                  <button type="button" class="rm-icon-button" data-action="downtime-page" data-page-type="{{#if downtime.showArchive}}archive{{else}}queue{{/if}}" data-direction="previous" data-tooltip="Предыдущая страница" {{#unless downtime.visiblePage.hasPrevious}}disabled{{/unless}}>
                    <i class="fa-solid fa-chevron-left"></i>
                  </button>
                  <span class="rm-muted">{{rmNum downtime.visiblePage.current precision=0}} / {{rmNum downtime.visiblePage.total precision=0}}</span>
                  <button type="button" class="rm-icon-button" data-action="downtime-page" data-page-type="{{#if downtime.showArchive}}archive{{else}}queue{{/if}}" data-direction="next" data-tooltip="Следующая страница" {{#unless downtime.visiblePage.hasNext}}disabled{{/unless}}>
                    <i class="fa-solid fa-chevron-right"></i>
                  </button>
                </nav>
              {{/if}}
            {{/if}}

            {{#if downtime.canSubmit}}
              <details class="rm-downtime-manual-request">
                <summary class="rm-toggle-affordance">Создать заявку вручную</summary>
                <div class="rm-downtime-manual-request__body">
                  <section class="rm-downtime-request-form">
                    <div class="rm-field">
                      <label>Персонаж</label>
                      <select data-action="downtime-request-actor" {{#if downtime.submitDisabled}}disabled{{/if}}>
                        {{#if downtime.requestActorOptions.length}}
                          {{#each downtime.requestActorOptions}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        {{else}}
                          <option value="">Нет доступных персонажей</option>
                        {{/if}}
                      </select>
                    </div>
                    <div class="rm-field">
                      <label>Действие</label>
                      <select data-action="downtime-request-action" {{#if downtime.submitDisabled}}disabled{{/if}}>
                        {{#each downtime.actionOptions}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>
                    <div class="rm-field rm-field--narrow">
                      <label>Недели</label>
                      <input type="number" min="1" step="1" value="{{downtime.requestWeeks}}" data-action="downtime-request-weeks" {{#if downtime.submitDisabled}}disabled{{/if}}>
                    </div>
                    <div class="rm-field">
                      <label>Название</label>
                      <input type="text" value="{{downtime.requestTitle}}" placeholder="Коротко о цели" data-action="downtime-request-title" {{#if downtime.submitDisabled}}disabled{{/if}}>
                    </div>
                    <div class="rm-field">
                      <label>Описание</label>
                      <textarea rows="2" placeholder="Что персонаж хочет сделать" data-action="downtime-request-description" {{#if downtime.submitDisabled}}disabled{{/if}}>{{downtime.requestDescription}}</textarea>
                    </div>
                    <button
                      type="button"
                      class="rm-button rm-button--small rm-button--primary"
                      data-action="downtime-submit"
                      title="{{downtime.submitDisabledReason}}"
                      {{#if downtime.submitDisabled}}disabled{{/if}}
                    >
                      <i class="fa-solid fa-paper-plane"></i>
                      <span>Отправить</span>
                    </button>
                  </section>
                </div>
              </details>
            {{/if}}
          </section>

        </div>
      </section>
    {{/if}}

    {{#if tabs.isCalendar}}
      <section class="rm-panel rm-panel--full rm-panel--compact">
        <div class="rm-panel__header rm-panel__header--compact">
          <h3>Календарь</h3>
          <span class="rm-muted">{{calendar.weekdayLabel}}</span>
        </div>

        <section class="rm-calendar-hero">
          <div class="rm-calendar-hero__meta">
            <h4>Сегодняшняя дата</h4>
            <p><strong>Дата:</strong> {{calendar.weekdayLabel}}, {{calendar.day}} {{calendar.monthName}} {{calendar.year}}</p>
            <p><strong>Луна:</strong> {{calendar.moon.phaseLabel}} (возраст ~{{rmNum calendar.moon.ageDays precision=2}} дн.)</p>
            <p><strong>Календарь:</strong> {{calendar.monthYearLabel}}</p>
          </div>

          <div class="rm-calendar-grid">
            {{#each calendar.weekdayHeaders}}
              <span class="rm-calendar-grid__weekday">{{this}}</span>
            {{/each}}

            {{#each calendar.cells}}
              <button
                type="button"
                class="rm-calendar-grid__day {{#if isOutsideMonth}}is-outside{{/if}} {{#if isCurrentDay}}is-current{{/if}} {{#if downtime.total}}has-downtime is-downtime-{{downtime.dominantStatus}}{{/if}}"
                data-action="calendar-pick-day"
                data-iso-date="{{isoDate}}"
                data-year="{{year}}"
                data-month="{{month}}"
                data-day="{{day}}"
              >
                <span class="rm-calendar-grid__day-number">{{day}}</span>
                {{#if downtime.total}}
                  <span class="rm-calendar-grid__total">{{downtime.total}}</span>
                {{/if}}
                <span class="rm-calendar-grid__markers">
                  {{#each downtime.markers}}
                    <span class="rm-calendar-grid__marker is-{{status}}" data-status="{{status}}" data-tooltip="{{label}}: {{count}}" aria-label="{{label}}: {{count}}">{{count}}</span>
                  {{/each}}
                </span>
              </button>
            {{/each}}
          </div>
        </section>

        <section class="rm-calendar-controls">
          <div class="rm-field rm-field--narrow">
            <label>Год</label>
            <input type="number" min="1" step="1" value="{{calendar.yearValue}}" data-field="calendar-year">
          </div>
          <div class="rm-field rm-field--narrow">
            <label>Месяц</label>
            <input type="number" min="1" max="12" step="1" value="{{calendar.monthValue}}" data-field="calendar-month">
          </div>
          <div class="rm-field rm-field--narrow">
            <label>День</label>
            <input type="number" min="1" max="31" step="1" value="{{calendar.dayValue}}" data-field="calendar-day">
          </div>
          <button type="button" class="rm-button rm-button--small" data-action="calendar-set">Установить дату</button>
        </section>

        <section class="rm-calendar-actions">
          <button type="button" class="rm-button rm-button--primary" data-action="calendar-advance" data-unit="day" data-value="1">Пропустить день</button>
          <button type="button" class="rm-button rm-button--secondary" data-action="calendar-advance" data-unit="week" data-value="1">Пропустить неделю</button>
          <button type="button" class="rm-button rm-button--secondary" data-action="calendar-advance" data-unit="month" data-value="1">Пропустить месяц</button>
        </section>
      </section>
        {{/if}}
      </div>
    </section>

    <nav class="rm-inventory-book__tabs" aria-label="Разделы партийного инвентаря">
      <button type="button" class="rm-inventory-book__tab {{#if tabs.isInventory}}is-active{{/if}}" data-action="switch-tab" data-tab="inventory">Инвентарь</button>
      <button type="button" class="rm-inventory-book__tab {{#if tabs.isParty}}is-active{{/if}}" data-action="switch-tab" data-tab="party">Группа</button>
      <button type="button" class="rm-inventory-book__tab {{#if tabs.isCraft}}is-active{{/if}}" data-action="switch-tab" data-tab="craft">Крафт</button>
      <button type="button" class="rm-inventory-book__tab {{#if tabs.isCalendar}}is-active{{/if}}" data-action="switch-tab" data-tab="calendar">Календарь</button>
      <button type="button" class="rm-inventory-book__tab {{#if tabs.isTravel}}is-active{{/if}}" data-action="switch-tab" data-tab="travel">Путешествие</button>
      <button type="button" class="rm-inventory-book__tab {{#if tabs.isTransport}}is-active{{/if}}" data-action="switch-tab" data-tab="transport">Транспорт</button>
      <button type="button" class="rm-inventory-book__tab {{#if tabs.isDowntime}}is-active{{/if}}" data-action="switch-tab" data-tab="downtime">Простой</button>
    </nav>
  </section>
{{/if}}

