<section class="tab {{ modificationTab.cssClass }} rm-modification-tab"
         data-tab="{{ modificationTab.id }}" data-group="{{ modificationTab.group }}">
  <header class="rm-modification-tab__header card">
    <div class="rm-modification-tab__copy">
      <h2>Модифицирование</h2>
      <p>Набор имплантов можно сменить во время продолжительного отдыха.</p>
    </div>
    <div class="rm-modification-tab__points" aria-label="Очки модификации">
      <span>Очки модификации</span>
      <strong>{{ modification.used }} / {{ modification.capacity }}</strong>
      <small>Свободно: {{ modification.remaining }}</small>
    </div>
  </header>

  <section class="rm-modification-tab__list card">
    <h3>Установленные</h3>
    <ul class="unlist">
      {{#each modification.installedEntries}}
        <li><a class="content-link" data-link data-uuid="{{uuid}}" href="#">{{name}}</a></li>
      {{else}}
        <li>Нет установленных имплантов</li>
      {{/each}}
    </ul>
  </section>

  <section class="rm-modification-tab__list card">
    <h3>Доступные к установке</h3>
    <ul class="unlist">
      {{#each installableImplants}}
        <li><a class="content-link" data-link data-uuid="{{uuid}}" href="#">{{name}}</a></li>
      {{else}}
        <li>Нет доступных имплантов</li>
      {{/each}}
    </ul>
  </section>
</section>
