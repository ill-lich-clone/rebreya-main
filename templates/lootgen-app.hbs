<section class="rm-shell rm-app-shell rm-lootgen-shell {{#if viewer}}rm-lootgen-shell--viewer{{/if}}">
  <div class="rm-lootgen-workbench {{#unless canManage}}rm-lootgen-workbench--viewer{{/unless}}">
    {{#if canManage}}
      <aside class="rm-app-sidebar rm-lootgen-controls">
        <div class="rm-app-section-heading">
          <p class="rm-eyebrow">Настройка</p>
          <h3>Параметры выдачи</h3>
          <p class="rm-muted">Главные параметры сверху, дополнительные источники спрятаны в настройках.</p>
        </div>

        <button type="button" class="rm-button rm-button--secondary" data-action="lootgen-new-window" title="Открыть ещё одно окно лутгена">
          <i class="fa-solid fa-window-restore"></i>
          <span>Новое окно</span>
        </button>

        <div class="rm-field">
          <label for="rm-lootgen-template-{{appKey}}">Шаблон генерации</label>
          <div class="rm-lootgen-primary-actions">
            <select id="rm-lootgen-template-{{appKey}}" data-action="lootgen-template-select">
              <option value="">Выберите шаблон</option>
              {{#each form.lootgenTemplates}}
                <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
            <button
              type="button"
              class="rm-button rm-button--secondary"
              data-action="lootgen-apply-template"
              {{#unless form.hasLootgenTemplates}}disabled{{/unless}}
            >
              <i class="fa-solid fa-file-import"></i>
              <span>Применить</span>
            </button>
            <button
              type="button"
              class="rm-button rm-button--secondary"
              data-action="lootgen-delete-template"
              title="Удалить выбранный шаблон"
              aria-label="Удалить выбранный шаблон"
              {{#unless form.hasLootgenTemplates}}disabled{{/unless}}
            >
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>

        <div class="rm-lootgen-control-grid">
          <div class="rm-field">
            <label title="Нижняя граница ранга для подбора предметов.">Минимальный ранг</label>
            <input type="number" min="0" max="10" step="1" value="{{form.rankMin}}" data-field="rankMin">
          </div>
          <div class="rm-field">
            <label title="Верхняя граница ранга для подбора предметов.">Максимальный ранг</label>
            <input type="number" min="0" max="10" step="1" value="{{form.rankMax}}" data-field="rankMax">
          </div>
          <div class="rm-field">
            <label title="Сколько позиций попытаться сгенерировать за один запуск.">Строк в выдаче</label>
            <input type="number" min="1" max="40" step="1" value="{{form.itemCount}}" data-field="itemCount">
          </div>
          <div class="rm-field">
            <label title="Мягкий ориентир количества копий одного предмета. Генератор может дать меньше или больше, если этого требует бюджет и формула предмета.">Оптимальное количество предметов</label>
            <input type="number" min="1" max="100" step="1" value="{{form.optimalItemQuantity}}" data-field="optimalItemQuantity">
          </div>
          <div class="rm-field">
            <label title="Общий лимит value на всю выдачу.">Бюджет, value</label>
            <input type="number" min="0" step="1" value="{{form.budgetValue}}" data-field="budgetValue">
          </div>
        </div>

        <details class="rm-app-settings-drawer rm-lootgen-settings">
          <summary class="rm-toggle-affordance">
            <span>Настройки генерации</span>
            <i class="fa-solid fa-chevron-down"></i>
          </summary>
          <div class="rm-lootgen-settings__content">
            <div class="rm-field">
              <label title="Шанс включить магический предмет в выдачу (0-100%).">% магических предметов</label>
              <input type="number" min="0" max="100" step="1" value="{{form.magicPercent}}" data-field="magicPercent">
            </div>
            <div class="rm-field">
              <label title="Независимый шанс для каждой строки обычного снаряжения появиться уже сломанной (0-100%).">% сломанного снаряжения</label>
              <input type="number" min="0" max="100" step="1" value="{{form.brokenEquipmentChance}}" data-field="brokenEquipmentChance">
            </div>

            <div class="rm-lootgen-switches">
              <label class="rm-lootgen-check">
                <input type="checkbox" {{#if form.includeGear}}checked{{/if}} data-field="includeGear">
                <span>Снаряжение</span>
              </label>
              <label class="rm-lootgen-check">
                <input type="checkbox" {{#if form.includeMagicItems}}checked{{/if}} data-field="includeMagicItems">
                <span>Магические предметы</span>
              </label>
              <label class="rm-lootgen-check">
                <input type="checkbox" {{#if form.includeCoins}}checked{{/if}} data-field="includeCoins">
                <span>Остаток в монеты</span>
              </label>
            </div>

            <div class="rm-lootgen-type-filters">
              {{#if form.hasGearTypeOptions}}
                <section class="rm-lootgen-type-filter">
                  <div class="rm-lootgen-type-filter__header">
                    <i class="fa-solid fa-toolbox"></i>
                    <span>Типы снаряжения</span>
                  </div>
                  <div class="rm-lootgen-type-filter__options">
                    {{#each form.gearTypeOptions}}
                      <label class="rm-lootgen-check rm-lootgen-check--compact">
                        <input
                          type="checkbox"
                          {{#if checked}}checked{{/if}}
                          data-action="lootgen-type-filter"
                          data-filter-group="gear"
                          data-type-key="{{key}}"
                        >
                        <span>{{label}}</span>
                      </label>
                    {{/each}}
                  </div>
                </section>
              {{/if}}

              {{#if form.hasMagicTypeOptions}}
                <section class="rm-lootgen-type-filter">
                  <div class="rm-lootgen-type-filter__header">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Типы магических предметов</span>
                  </div>
                  <div class="rm-lootgen-type-filter__options">
                    {{#each form.magicTypeOptions}}
                      <label class="rm-lootgen-check rm-lootgen-check--compact">
                        <input
                          type="checkbox"
                          {{#if checked}}checked{{/if}}
                          data-action="lootgen-type-filter"
                          data-filter-group="magic"
                          data-type-key="{{key}}"
                        >
                        <span>{{label}}</span>
                      </label>
                    {{/each}}
                  </div>
                </section>
              {{/if}}
            </div>
          </div>
        </details>

        <div class="rm-lootgen-primary-actions">
          <button
            type="button"
            class="rm-button rm-button--primary rm-button--wide"
            data-action="lootgen-generate"
            title="{{#if form.generateDisabled}}{{form.generateDisabledReason}}{{else}}Сгенерировать добычу по текущим параметрам{{/if}}"
            {{#if form.generateDisabled}}disabled{{/if}}
          >
            <i class="fa-solid fa-dice"></i>
            <span>Сгенерировать</span>
          </button>
          <button type="button" class="rm-button rm-button--secondary" data-action="lootgen-clear" title="Очистить текущий результат лутгена">
            <i class="fa-solid fa-eraser"></i>
            <span>Очистить</span>
          </button>
        </div>
        <button
          type="button"
          class="rm-button rm-button--secondary rm-button--wide"
          data-action="lootgen-save-template"
          title="Сохранить текущие настройки генерации как шаблон"
        >
          <i class="fa-solid fa-floppy-disk"></i>
          <span>Сохранить шаблон</span>
        </button>
      </aside>
    {{/if}}

    <section class="rm-app-main rm-lootgen-result-panel">
      <div class="rm-panel__header rm-panel__header--compact">
        <div>
          <h3>{{#if viewer}}Найденные сокровища{{else}}Результат выдачи{{/if}}</h3>
          {{#if generated.generatedAt}}
            <p class="rm-muted">{{generated.generatedAt}}</p>
          {{else}}
            <p class="rm-muted">После генерации здесь появятся предметы, монеты и действия.</p>
          {{/if}}
        </div>

        {{#if canManage}}
          {{#if generated.hasResult}}
            <button type="button" class="rm-button rm-button--primary" data-action="lootgen-send-chat" title="Отправить результат в чат: игроки смогут перетащить предметы в лист персонажа">
              <i class="fa-solid fa-message"></i>
              <span>Отправить в чат</span>
            </button>
          {{/if}}
        {{/if}}
      </div>

      {{#if generated.hasResult}}
        <section class="rm-compact-pill-strip rm-compact-pill-strip--lootgen">
          <div class="rm-compact-pill">
            <span>Строк</span>
            <strong>{{rmNum generated.rows.length precision=0}}</strong>
          </div>
          <div class="rm-compact-pill">
            <span>Предметов</span>
            <strong>{{rmNum generated.totalItems precision=0}}</strong>
          </div>
          <div class="rm-compact-pill">
            <span>Потрачено</span>
            <strong>{{rmNum generated.spentValue precision=0}} value</strong>
          </div>
          <div class="rm-compact-pill">
            <span>Монеты</span>
            <strong>{{generated.coinsLabel}}</strong>
          </div>
        </section>

        {{#if generated.hasRows}}
          <div class="rm-lootgen-result-list">
            {{#each generated.rows}}
              <article class="rm-lootgen-result-row">
                <div class="rm-lootgen-result-row__main">
                  <strong>
                    <button
                      type="button"
                      class="rm-link-button rm-link-button--accent"
                      data-action="lootgen-open-entry"
                      data-row-index="{{rowIndex}}"
                      title="Открыть предмет"
                    >
                      {{name}}
                    </button>
                  </strong>
                  <p class="rm-muted">
                    {{typeLabel}} • ранг {{rank}} • {{rmNum value precision=0}} value • x{{rmNum quantity precision=0}}
                  </p>
                  {{#if isBroken}}
                    <span class="rm-lootgen-condition rm-lootgen-condition--broken">
                      <i class="fa-solid fa-link-slash"></i>
                      Сломано
                    </span>
                  {{/if}}
                </div>
                <div class="rm-lootgen-result-row__side">
                  <span>{{rmNum totalValue precision=0}} value</span>
                  {{#if ../canManage}}
                    <button type="button" class="rm-icon-button" data-action="lootgen-take-row" data-row-index="{{rowIndex}}" title="Добавить строку в склад">
                      <i class="fa-solid fa-inbox"></i>
                    </button>
                  {{/if}}
                </div>
              </article>
            {{/each}}
          </div>
        {{/if}}

        {{#if canManage}}
          <div class="rm-lootgen-actions">
            <button type="button" class="rm-button rm-button--secondary" data-action="lootgen-take-all" title="Перенести всю сгенерированную добычу в партийный склад">
              <i class="fa-solid fa-boxes-stacked"></i>
              <span>Всю добычу в склад</span>
            </button>
            <button
              type="button"
              class="rm-button rm-button--secondary"
              data-action="lootgen-take-coins"
              title="{{#if generated.hasCoins}}Перенести в склад только монеты{{else}}Нет монет для переноса{{/if}}"
              {{#unless generated.hasCoins}}disabled{{/unless}}
            >
              <i class="fa-solid fa-coins"></i>
              <span>Только монеты</span>
            </button>
          </div>
        {{/if}}
      {{else}}
        <div class="rm-empty rm-lootgen-empty">
          {{#if viewer}}
            Мастер ещё не отправил найденные сокровища.
          {{else}}
            <strong>Сгенерируйте добычу.</strong>
            <span>После этого результат можно отправить в чат или перенести в партийный склад.</span>
          {{/if}}
        </div>
      {{/if}}
    </section>
  </div>
</section>
