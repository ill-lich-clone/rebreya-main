<form class="rm-fql-activity-editor rm-fql-event-editor" autocomplete="off">
  <div class="rm-fql-editor-field">
    <label>Название</label>
    <input type="text" name="rm-fql-event-title" value="{{event.title}}" {{#unless canEdit}}readonly{{/unless}}>
  </div>

  <div class="rm-fql-editor-field rm-fql-editor-field--grow">
    <label>Описание</label>
    <textarea name="rm-fql-event-text" rows="12" {{#unless canEdit}}readonly{{/unless}}>{{event.text}}</textarea>
  </div>

  {{#if canEdit}}
    <footer class="rm-fql-editor-actions">
      <button type="button" data-rm-fql-editor-action="save-event"><i class="fas fa-save"></i> Сохранить</button>
      <button type="button" data-rm-fql-editor-action="remove-event"><i class="fas fa-trash"></i> Удалить</button>
    </footer>
  {{/if}}
</form>
