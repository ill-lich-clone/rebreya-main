<section class="rm-shell scrollable">
  <header class="rm-hero">
    <div>
      <p class="rm-eyebrow">Управление группами</p>
      <h2>Группы Rebreya</h2>
      <p class="rm-muted">
        Зарегистрировано: {{registeredCount}}.
        {{#if activeGroupName}}Активная: {{activeGroupName}}.{{else}}Активная группа не выбрана.{{/if}}
      </p>
    </div>
  </header>

  {{#if hasGroups}}
    <section class="rm-panel rm-panel--full rm-panel--compact">
      <div class="rm-panel__header rm-panel__header--compact">
        <h3>dnd5e группы</h3>
        <span class="rm-muted">{{groups.length}} шт.</span>
      </div>

      <div class="rm-groups-grid">
        {{#each groups}}
          <article class="rm-group-card {{stateClass}}" data-group-id="{{id}}">
            <header class="rm-group-card__header">
              <img class="rm-group-card__image" src="{{img}}" alt="{{name}}">
              <div class="rm-group-card__identity">
                <strong class="rm-group-card__name">{{name}}</strong>
                <p class="rm-group-card__id">{{id}}</p>
              </div>

              <details class="rm-inline-menu rm-inline-menu--service rm-group-card__menu">
                <summary class="rm-inline-menu__toggle rm-icon-button" title="Дополнительные действия">
                  <i class="fa-solid fa-ellipsis"></i>
                </summary>
                <div class="rm-inline-menu__panel rm-inline-menu__panel--stack">
                  <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="merge-legacy-inventory" data-group-id="{{id}}" {{#unless canMergeLegacy}}disabled{{/unless}}>
                    <i class="fa-solid fa-code-merge"></i>
                    <span>Перенести legacy</span>
                  </button>
                  {{#if migration.hasLegacyMerge}}
                    <p class="rm-group-card__migration">
                      {{#if migration.legacyMergedAtLabel}}{{migration.legacyMergedAtLabel}}{{else}}Есть отметки миграции{{/if}}
                      {{#if migration.completedPairCount}} • пар: {{migration.completedPairCount}}{{/if}}
                    </p>
                  {{/if}}
                </div>
              </details>
            </header>

            <div class="rm-group-card__badges">
              {{#if active}}
                <span class="rm-group-card__badge is-active">Активная</span>
              {{/if}}
              {{#if registered}}
                <span class="rm-group-card__badge is-registered">Зарегистрирована</span>
              {{else}}
                <span class="rm-group-card__badge is-unregistered">Не зарегистрирована</span>
              {{/if}}
            </div>

            <div class="rm-group-card__facts">
              <div class="rm-group-card__fact">
                <span>Участники</span>
                <strong>{{memberCount}}</strong>
              </div>
              <div class="rm-group-card__fact">
                {{#if hasInitializedAt}}
                  <span>Инициализирована</span>
                  <strong>{{initializedAtLabel}}</strong>
                {{else}}
                  <span>Состояние</span>
                  <strong>Не подключена к Rebreya</strong>
                {{/if}}
              </div>
            </div>

            <footer class="rm-group-card__actions">
              <button type="button" class="rm-button rm-button--small rm-button--secondary" data-action="open-sheet" data-group-id="{{id}}">
                <i class="fa-solid fa-up-right-from-square"></i>
                <span>Открыть лист</span>
              </button>
              {{#if showRegister}}
                <button type="button" class="rm-button rm-button--small rm-button--primary" data-action="register-group" data-group-id="{{id}}">
                  <i class="fa-solid fa-clipboard-check"></i>
                  <span>Зарегистрировать</span>
                </button>
              {{/if}}
              {{#if showSetActive}}
                <button type="button" class="rm-button rm-button--small rm-button--primary" data-action="set-active-group" data-group-id="{{id}}">
                  <i class="fa-solid fa-users-viewfinder"></i>
                  <span>Сделать активной</span>
                </button>
              {{/if}}
              {{#if showCurrentGroup}}
                <span class="rm-group-card__current">
                  <i class="fa-solid fa-circle-check"></i>
                  Текущая группа
                </span>
              {{/if}}
            </footer>
          </article>
        {{/each}}
      </div>
    </section>
  {{else}}
    <section class="rm-panel">
      <p class="rm-empty">
        В мире нет актёров dnd5e типа «Группа». Создайте актёра типа «Группа» через обычный интерфейс Foundry, затем вернитесь сюда для регистрации и выбора активной группы Rebreya.
      </p>
    </section>
  {{/if}}
</section>
